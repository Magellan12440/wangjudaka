.head { padding: 28rpx 4rpx 18rpx; }
.title { font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.sub { margin-top: 8rpx; font-size: 22rpx; color: #8B95A5; }

.card { padding: 26rpx 24rpx; margin-bottom: 20rpx; }
.card-title { font-size: 23rpx; color: #6E7B8E; margin-bottom: 16rpx; letter-spacing: 1rpx; }

.hero { padding: 30rpx 26rpx; }
.hero-label { font-size: 22rpx; color: #6E7B8E; }
.hero-num {
  margin-top: 8rpx;
  font-size: 76rpx; font-weight: 700; line-height: 1.1;
  color: #B4551A; font-variant-numeric: tabular-nums;
  text-shadow: 0 10rpx 40rpx rgba(232, 145, 47, 0.25);
}

.idx {
  margin-right: 8rpx; padding: 0 8rpx; border-radius: 6rpx;
  font-size: 19rpx; color: #E0BD77;
  background: rgba(232, 145, 47, 0.12);
  font-family: "SF Mono", Menlo, monospace;
}

.empty { text-align: center; padding: 44rpx 30rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; }
.empty-sub { margin-top: 12rpx; font-size: 22rpx; line-height: 1.7; color: #8B95A5; }
.err { color: #D8453C; font-size: 24rpx; }

/* —— 额度预警（V4.5）—— */
.quota-bar {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 24rpx; margin-bottom: 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 142, 142, 0.28);
  background: linear-gradient(150deg, rgba(255, 120, 120, 0.14), rgba(255, 120, 120, 0.03));
}
.quota-bar.low {
  border-color: rgba(232, 145, 47, 0.3);
  background: linear-gradient(150deg, rgba(232, 145, 47, 0.13), rgba(232, 145, 47, 0.02));
}
.quota-main { flex: 1; min-width: 0; }
.quota-title { font-size: 26rpx; font-weight: 700; color: #FFE3E1; }
.quota-bar.low .quota-title { color: #FFE0AE; }
.quota-sub { margin-top: 8rpx; font-size: 21rpx; line-height: 1.55; color: #4A566B; }
.quota-btn {
  flex: none; padding: 14rpx 24rpx; border-radius: 999rpx;
  font-size: 23rpx; font-weight: 700; color: #6B3A0C;
  background: linear-gradient(128deg, #FFC978, #E08A22 55%, #FB7A34);
}

/* —— 待回填 —— */
.fill-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.ghost-btn {
  flex: none; padding: 13rpx 26rpx; border-radius: 999rpx;
  font-size: 23rpx; color: #8A6A3A;
  border: 1rpx solid rgba(232, 145, 47, 0.36);
  background: rgba(232, 145, 47, 0.08);
}
.fill-sub { font-size: 21rpx; color: #8B95A5; }
.fill-btn {
  flex: none; padding: 14rpx 26rpx; border-radius: 999rpx;
  font-size: 23rpx; font-weight: 700; color: #6B3A0C;
  background: linear-gradient(128deg, #FFC978, #E08A22 55%, #FB7A34);
  box-shadow: 0 10rpx 24rpx rgba(251, 122, 52, 0.28);
}

.fill-row { padding: 20rpx 0; border-bottom: 1rpx solid rgba(22, 35, 58, 0.07); }
.fill-row:last-child { border-bottom: none; }
.fill-row-top { display: flex; align-items: baseline; gap: 12rpx; }
.fill-row-name { font-size: 25rpx; font-weight: 600; color: #22314A; }
.fill-row-title { flex: 1; min-width: 0; font-size: 20rpx; color: #8B95A5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fill-row-ctrl { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; }
.fill-input {
  flex: 1; height: 76rpx; line-height: 76rpx; padding: 0 20rpx;
  border-radius: 16rpx; font-size: 28rpx; color: #16233A;
  background: rgba(22, 35, 58, 0.05);
  border: 1rpx solid rgba(22, 35, 58, 0.1);
  font-variant-numeric: tabular-nums;
}
/* 小号分段：没有滑块指示器，on 态直接给底色，否则深色文字落在深色底上会看不清 */
.seg.tiny { flex: none; margin-bottom: 0; padding: 5rpx; border-radius: 16rpx; }
.seg.tiny .seg-item { flex: none; padding: 0 16rpx; height: 66rpx; line-height: 66rpx; font-size: 22rpx; border-radius: 12rpx; }
.seg.tiny .seg-item.on {
  background: linear-gradient(120deg, #FFC978, #E08A22 55%, #FF9A45);
  color: #FFFFFF; font-weight: 650;
  box-shadow: 0 8rpx 20rpx rgba(251, 122, 52, 0.28);
}

/* 排行榜入口（V4.16） */
.head.between { display: flex; align-items: flex-start; }
.rank-link {
  flex: none; margin-left: 16rpx; margin-top: 10rpx;
  font-size: 22rpx; font-weight: 600; color: #C57A1E;
  padding: 10rpx 18rpx; border-radius: 999rpx;
  background: #FFF6EA; border: 1rpx solid rgba(232, 162, 74, 0.34);
}
