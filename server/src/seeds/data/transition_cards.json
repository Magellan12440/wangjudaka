  { "code": "TRN-DISSOLVE-W", "name": "白闪", "kind": "post", "ffmpeg": "xfade=transition=fadewhite:duration={D}:offset={OFF}", "duration": 0.3, "use_case": "回忆、冲击", "risk": "low" },
  { "code": "TRN-DISSOLVE-B", "name": "黑场", "kind": "post", "ffmpeg": "xfade=transition=fadeblack:duration={D}:offset={OFF}", "duration": 0.4, "use_case": "段落结束", "risk": "low" },
  { "code": "TRN-WIPE-R", "name": "右划", "kind": "post", "ffmpeg": "xfade=transition=wiperight:duration={D}:offset={OFF}", "duration": 0.5, "use_case": "并列对比", "risk": "low" },
  { "code": "TRN-WIPE-UP", "name": "上划", "kind": "post", "ffmpeg": "xfade=transition=wipeup:duration={D}:offset={OFF}", "duration": 0.5, "use_case": "榜单、展示", "risk": "low" },
  { "code": "TRN-SLIDE-L", "name": "左滑", "kind": "post", "ffmpeg": "xfade=transition=slideleft:duration={D}:offset={OFF}", "duration": 0.4, "use_case": "快节奏 vlog 感", "risk": "low" },
  { "code": "TRN-CIRCLE", "name": "圆形开", "kind": "post", "ffmpeg": "xfade=transition=circleopen:duration={D}:offset={OFF}", "duration": 0.5, "use_case": "章回体、集首", "risk": "low" },
  { "code": "TRN-PIXEL", "name": "像素化", "kind": "post", "ffmpeg": "xfade=transition=pixelize:duration={D}:offset={OFF}", "duration": 0.4, "use_case": "赛博、游戏感", "risk": "low" },
  { "code": "TRN-RADIAL", "name": "放射", "kind": "post", "ffmpeg": "xfade=transition=radial:duration={D}:offset={OFF}", "duration": 0.5, "use_case": "高光时刻", "risk": "low" },
  { "code": "TRN-HLUMA", "name": "亮度溶解", "kind": "post", "ffmpeg": "xfade=transition=hluma:duration={D}:offset={OFF}", "duration": 0.5, "use_case": "高级质感", "risk": "low" },
  { "code": "TRN-ZOOM", "name": "缩放转", "kind": "post", "ffmpeg": "scale keyframes + fade", "duration": 0.4, "use_case": "强调、进入", "risk": "medium" },
  { "code": "TRN-JCUT", "name": "J 切（声先入）", "kind": "post", "ffmpeg": "audio advance 0.3s", "duration": 0.3, "use_case": "对话自然衔接", "risk": "low" },
  { "code": "TRN-LCUT", "name": "L 切（声延续）", "kind": "post", "ffmpeg": "audio delay 0.5s", "duration": 0.5, "use_case": "对话自然衔接", "risk": "low" },
  { "code": "TRN-FREEZE", "name": "定格", "kind": "post", "ffmpeg": "freeze last frame 0.6s + hard cut", "duration": 0.6, "use_case": "强调、悬念、集末", "risk": "low" }
