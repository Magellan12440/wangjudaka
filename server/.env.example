# ============ 灵悟漫剧工作台 · 服务端环境变量模板 ============
# 复制为 .env.local 后填写真实值。.env.local 已被 .gitignore 排除。
# 这些值【只允许存在于服务端】，任何情况下不得下发到小程序前端。

# ---------- 算力池：灵悟中转站（代理商主账号） ----------
# OpenAI 兼容网关地址
RELAY_GATEWAY=https://api.lingkeai.ai/v1
# 主账号 API Key（sk- 开头）。留空则自动进入 MOCK 模式（本地联调用，不产生真实消耗）
# 也可不配这里：管理台「算力网关」里填，存数据盘、立即生效、轮换不用发版
RELAY_API_KEY=
# 备用网关（多线路容灾，逗号分隔，可留空）
RELAY_GATEWAY_BACKUP=
# 单 Key 并发上限（代理商主账号通常为 8~32，按合同填写）
RELAY_MAX_CONCURRENCY=8
# 每分钟请求上限
RELAY_RPM_LIMIT=240

# ---------- 主账号控制台凭据（仅用于人工补仓/对账，禁止前端可见）----------
RELAY_CONSOLE_ACCOUNT=
RELAY_CONSOLE_PASSWORD=

# ---------- 算力池水位告警 ----------
# 比例制：MOCK / 余额接口不可用时生效
POOL_WARN_RATIO=0.30
POOL_CRITICAL_RATIO=0.15
POOL_FUSE_RATIO=0.05
# 绝对值制（V3.5）：live 模式优先，按真实算力余额判定
POOL_WARN_SUANLI=5
POOL_CRITICAL_SUANLI=2
POOL_FUSE_SUANLI=0.5
POOL_BALANCE_TTL_MS=60000

# ---------- 点数与计费 ----------
# 1 点 = 1 元人民币
CREDIT_CNY_PER_POINT=1.00
# 统一计费倍率：全系统「实际消耗 × 2」扣点（V4.3 定价规则，改这一个值即可）
CREDIT_MARKUP=2
# 上游按美元计价时的汇率（定期更新）
USD_CNY_RATE=7.10
# 中转站算力与人民币换算（按代理商合同口径；灵悟实测 1 算力≈1 元）
SUANLI_CNY_RATE=1.00

# ---------- 服务 ----------
PORT=8787
NODE_ENV=development
# 强制 MOCK（true 时即使有 Key 也不真实调用，用于演示/压测）
RELAY_MOCK=false
# 媒体任务制轮询：视频可能需要数分钟
RELAY_MEDIA_POLL_INTERVAL_MS=5000
RELAY_MEDIA_POLL_TIMEOUT_MS=600000

# ---------- 存储 ----------
DATA_DIR=./data

# ---------- 微信小程序通道（V3.5）----------
# 企业主体小程序 AppID 与 secret（微信公众平台 → 开发管理）
# 留空则登录/机审/支付全部自动降级为 mock 联调模式（响应显式标注 mode:'mock'）
WX_APPID=
WX_SECRET=
# 会话签名密钥：不填则进程内随机（重启后旧会话全部失效，生产建议固定）
SESSION_SECRET=
SESSION_TTL_MS=604800000
# 内容安全机审开关（配置了 AppID 后默认开；false 仅限调试，上线必须为 true）
WX_SEC_CHECK_ENABLED=true
# 微信虚拟支付（iOS 合规唯一通道；米大师商户）
WX_PAY_OFFER_ID=
WX_PAY_APP_KEY=
WX_PAY_MCHID=
WX_PAY_NOTIFY_URL=
# 0=正式 1=沙箱（联调期间保持 1）
WX_PAY_ENV=1

# ---------- 合规 ----------
# AI 生成内容标识（写进片头/封面/简介/元数据），不可关闭
AI_LABEL_ENABLED=true
AI_LABEL_TEXT=本作品由人工智能生成

# ---------- 一致性比对服务（阶段 H / P0-1，可选）----------
# 接 CLIP / InsightFace / 自建图像比对服务。留空 = 不注册 provider，
# 所有镜头恒为 degraded、交付闸门阻断（刻意设计，不允许假装通过）。
# 契约：POST 该地址，body {reference, candidate, generated_url}，
#       响应 {score: 0~1, dimensions?: {...}}；Bearer Token 可选。
QC_COMPARE_ENDPOINT=
QC_COMPARE_TOKEN=
QC_COMPARE_TIMEOUT_MS=8000
QC_COMPARE_PROVIDER_NAME=http_clip
