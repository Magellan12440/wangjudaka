.login { display: flex; flex-direction: column; justify-content: center; min-height: 100vh; padding: 0 40rpx; }
.brand { text-align: center; margin-bottom: 56rpx; }
.brand-mark {
  width: 108rpx; height: 108rpx; margin: 0 auto 22rpx;
  border-radius: 30rpx; line-height: 108rpx; text-align: center;
  font-size: 46rpx; font-weight: 700; color: #6B3A0C;
  background: linear-gradient(140deg, #FFD79A, #FF9A45);
  box-shadow: 0 20rpx 44rpx -22rpx rgba(232, 145, 47, 0.85);
  animation: markIn .7s cubic-bezier(.2,.9,.2,1) both;
}
@keyframes markIn { from { opacity: 0; transform: translate3d(0, 18rpx, 0) scale(.86); } to { opacity: 1; transform: none; } }
.brand-name { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.brand-slogan { margin-top: 10rpx; font-size: 23rpx; color: #8B95A5; }

.card { padding: 28rpx 26rpx 30rpx; }
.wx-hint { margin: 26rpx 0 22rpx; font-size: 23rpx; line-height: 1.7; color: #6E7B8E; }
.dev-code {
  display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap;
  margin-top: 16rpx; padding: 16rpx 18rpx; border-radius: 16rpx;
  background: rgba(232, 145, 47, 0.07);
  border: 1rpx dashed rgba(232, 145, 47, 0.35);
}
.dev-num { font-size: 30rpx; font-weight: 700; letter-spacing: 4rpx; color: #C57A1E; }
.dev-note { flex: 1; min-width: 220rpx; font-size: 19rpx; color: #8A5A20; line-height: 1.5; }

.err { margin-top: 18rpx; font-size: 22rpx; color: #D8453C; }

.agree { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 30rpx; padding: 0 6rpx; }
.checkbox {
  flex: none; width: 34rpx; height: 34rpx; margin-top: 3rpx;
  border-radius: 10rpx; text-align: center; line-height: 34rpx;
  font-size: 22rpx; color: #6B3A0C;
  border: 1rpx solid rgba(22, 35, 58, 0.2);
  background: rgba(22, 35, 58, 0.05);
  transition: background .2s ease, border-color .2s ease;
}
.checkbox.on { background: linear-gradient(135deg, #FFB971, #FF9A45); border-color: transparent; }
.agree-text { font-size: 21rpx; color: #8B95A5; line-height: 1.6; }
.link { color: #E08A22; }

/* 「能力未开通」这类中性提示：不用红字，避免和真正的报错混淆 */
.sms-note {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(232, 145, 47, 0.08);
  border: 1rpx solid rgba(232, 145, 47, 0.22);
  font-size: 22rpx; line-height: 1.6; color: #8A5A20;
}

/* —— 注册 / 找回密码 —— */
.alt-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 22rpx;
}
.alt-link { font-size: 23rpx; color: #C4691A; padding: 8rpx 6rpx; }
.alt-sep { font-size: 22rpx; color: #C3CCDA; }
.sheet-tip {
  font-size: 23rpx;
  color: #6E7B8E;
  line-height: 1.65;
  margin-bottom: 20rpx;
}
