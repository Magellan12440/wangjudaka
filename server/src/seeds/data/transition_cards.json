[
  { "code": "TRN-OBJWIPE", "name": "物体遮挡切", "kind": "in_camera", "prompt_en": "a dark object sweeps across the lens and fully covers the frame at the end; the next shot begins from behind the same object", "prompt_zh": "暗色物体扫过镜头完全遮挡画面", "use_case": "通用，最安全的隐藏切", "duration": 0, "risk": "low" },
  { "code": "TRN-BODYWIPE", "name": "身体遮挡切", "kind": "in_camera", "prompt_en": "the actor's shoulder or back moves into frame and completely blocks the lens at the end", "prompt_zh": "演员肩膀或背影入画完全遮挡", "use_case": "人物戏", "duration": 0, "risk": "low" },
  { "code": "TRN-WATERWIPE", "name": "水/蒸汽切", "kind": "in_camera", "prompt_en": "steam rises and fills the frame, turning the image to white at the end", "prompt_zh": "蒸汽升腾填满画面转为白色", "use_case": "厨房、浴室、打斗", "duration": 0, "risk": "low" },
  { "code": "TRN-WHIP", "name": "甩镜切", "kind": "in_camera", "prompt_en": "the camera whips rapidly to the right, motion-blurring the entire frame at the end", "prompt_zh": "镜头快速甩动全画面动态模糊", "use_case": "场景切换、时间跳跃", "duration": 0, "risk": "medium" },
  { "code": "TRN-MATCH", "name": "匹配切", "kind": "in_camera", "prompt_en": "the subject's hand reaches the same position as the previous shot's final pose; match on action", "prompt_zh": "动作匹配，手部到达上一镜结束姿态", "use_case": "同动作跨时空", "duration": 0, "risk": "low" },
  { "code": "TRN-MATCHSHAPE", "name": "形状匹配切", "kind": "in_camera", "prompt_en": "the final frame's circular shape matches the next shot's opening circular shape", "prompt_zh": "形状呼应，圆形对圆形", "use_case": "高级剪辑，意象衔接", "duration": 0, "risk": "medium" },
  { "code": "TRN-INTODARK", "name": "入黑", "kind": "in_camera", "prompt_en": "the frame gradually darkens until it is fully black at the end", "prompt_zh": "画面渐暗至全黑", "use_case": "段落结束、时间流逝", "duration": 0, "risk": "low" },
  { "code": "TRN-INTOWHITE", "name": "入白", "kind": "in_camera", "prompt_en": "the frame blows out to pure white at the end", "prompt_zh": "画面过曝至纯白", "use_case": "回忆、闪白、冲击", "duration": 0, "risk": "low" },
  { "code": "TRN-DOORWAY", "name": "门框穿行", "kind": "in_camera", "prompt_en": "the subject walks through a doorway and the frame is filled by the dark doorway at the end", "prompt_zh": "人物穿过门框，画面被暗色门洞填满", "use_case": "空间转换", "duration": 0, "risk": "low" },
  { "code": "TRN-REFLECT", "name": "反射切入", "kind": "in_camera", "prompt_en": "the camera pushes into a reflective surface until the reflection fills the frame", "prompt_zh": "推入反光面直到反射充满画面", "use_case": "心理戏、回忆入口", "duration": 0, "risk": "medium" },
  { "code": "TRN-ZOOMIN", "name": "推入穿越", "kind": "in_camera", "prompt_en": "camera pushes in continuously until it passes through the subject's eye", "prompt_zh": "持续推入直至穿过人物眼睛", "use_case": "进入内心 / 超现实", "duration": 0, "risk": "high" },
  { "code": "TRN-CROWD", "name": "人群穿过", "kind": "in_camera", "prompt_en": "the crowd walks between camera and subject, fully occluding the frame", "prompt_zh": "人群从镜头与主体间穿过完全遮挡", "use_case": "街景、群戏", "duration": 0, "risk": "medium" },

  { "code": "TRN-HARDCUT", "name": "硬切", "kind": "post", "ffmpeg": "concat", "duration": 0, "use_case": "默认，90% 场景", "risk": "low" },
