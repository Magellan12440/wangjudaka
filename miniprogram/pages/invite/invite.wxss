/* ============================================================
   邀请返利 · 夜戏设计系统 v2
   ============================================================ */

.inv-layer { padding: 20rpx 28rpx 40rpx; box-sizing: border-box; }

.inv-head { padding: 8rpx 4rpx 30rpx; animation: rise 0.5s cubic-bezier(0.16, 0.84, 0.28, 1) both; }

/* —— 票券 —— */
.ticket {
  position: relative;
  border-radius: 32rpx;
  background:
    radial-gradient(120% 90% at 0% 0%, rgba(255, 255, 255, 0.42), transparent 56%),
    linear-gradient(145deg, #FFEFC9 0%, #F5CE87 44%, #E3AC55 100%);
  box-shadow: 0 26rpx 64rpx rgba(226, 155, 63, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.7);
  animation: rise 0.56s cubic-bezier(0.16, 0.84, 0.28, 1) 0.05s both;
}
.ticket::after {
  content: ""; position: absolute; inset: 0; border-radius: 32rpx;
  background: linear-gradient(115deg, transparent 32%, rgba(255, 255, 255, 0.38) 47%, transparent 62%);
  transform: translateX(-130%);
  animation: balSweep 6.8s ease-in-out infinite;
  pointer-events: none;
}
@keyframes balSweep { 0%, 58% { transform: translateX(-130%); } 92%, 100% { transform: translateX(130%); } }

.ticket-body { padding: 30rpx 32rpx 26rpx; position: relative; z-index: 2; }
.ticket-label { font-size: 22rpx; color: #7B5F2B; letter-spacing: 2rpx; font-weight: 600; }
.code-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 18rpx;
}
.code-text {
  font-size: 62rpx; font-weight: 800; color: #2A1B05;
  letter-spacing: 6rpx; line-height: 1.1;
}
.code-btn {
  font-size: 22rpx; font-weight: 700; color: #FFE7B4;
  padding: 12rpx 24rpx; border-radius: 999rpx;
  background: linear-gradient(140deg, #3B2A0B, #221604);
  box-shadow: 0 10rpx 22rpx rgba(42, 27, 5, 0.3);
}
.ticket-tip { font-size: 22rpx; color: #6B5A33; line-height: 1.66; margin-top: 16rpx; }

.ticket-cut { display: flex; align-items: center; position: relative; z-index: 2; }
.notch {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  background: #07080D; flex-shrink: 0;
}
.notch-l { margin-left: -15rpx; }
.notch-r { margin-right: -15rpx; }
.dash {
  flex: 1; height: 2rpx; margin: 0 12rpx;
  background: repeating-linear-gradient(90deg, rgba(90, 65, 20, 0.34) 0 10rpx, transparent 10rpx 20rpx);
}

.ticket-foot {
  display: flex; padding: 22rpx 20rpx 4rpx;
  position: relative; z-index: 2;
}
.tf-cell { flex: 1; text-align: center; position: relative; }
.tf-cell + .tf-cell::before {
  content: ""; position: absolute; left: 0; top: 6rpx; bottom: 6rpx; width: 1rpx;
  background: rgba(90, 65, 20, 0.16);
}
.tf-value { font-size: 40rpx; font-weight: 800; color: #2A1B05; line-height: 1.15; }
.tf-label { font-size: 20rpx; color: #7B5F2B; margin-top: 6rpx; }

.ticket-actions {
  display: flex; padding: 24rpx 32rpx 30rpx;
  position: relative; z-index: 2;
}
.ticket-actions .btn { flex: 1; margin-right: 16rpx; }
.ticket-actions .btn:last-child { margin-right: 0; }
.ticket-actions .btn-plain {
  background: rgba(255, 255, 255, 0.56);
  color: #4A360F;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  line-height: 64rpx; padding: 0;
}

/* —— 步骤 —— */
.step { display: flex; }
.step:last-child, .step.last { margin-bottom: 0; }
.step-rail {
  width: 52rpx; display: flex; flex-direction: column; align-items: center;
  flex-shrink: 0;
}
.step-dot {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; font-weight: 700; color: #241705;
  background: linear-gradient(145deg, #FFE2A6, #E8B75E);
  box-shadow: 0 0 0 4rpx rgba(243, 201, 105, 0.12);
  margin-top: 2rpx;
}
.step-line {
  flex: 1; width: 2rpx; margin: 8rpx 0;
  background: linear-gradient(180deg, rgba(243, 201, 105, 0.42), rgba(255, 255, 255, 0.06));
}
.step-body { flex: 1; padding: 0 0 30rpx 18rpx; min-width: 0; }
.step.last .step-body { padding-bottom: 0; }
.step-title { font-size: 27rpx; color: #EDF1F8; font-weight: 600; }
.step-desc { font-size: 22rpx; color: #7C8799; line-height: 1.66; margin-top: 8rpx; }

/* —— 邀请记录 —— */
.inv-item {
  display: flex; align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}
.inv-item:first-child { padding-top: 4rpx; }
.inv-item:last-child { border-bottom: none; padding-bottom: 4rpx; }
.inv-avatar {
  width: 76rpx; height: 76rpx; border-radius: 24rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; color: #B7C1D1;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.025));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-right: 20rpx;
}
.inv-name { font-size: 27rpx; color: #EDF1F8; font-weight: 550; }

/* —— 规则 —— */
.rule-row { display: flex; align-items: flex-start; margin-top: 14rpx; }
.rule-dot { color: #F3C969; margin-right: 12rpx; font-size: 24rpx; line-height: 1.5; }
.rule-text { font-size: 23rpx; color: #98A3B6; line-height: 1.62; }
