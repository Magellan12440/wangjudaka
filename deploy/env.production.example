# ============================================================
# 网剧大咖 · 生产环境变量模板
#
# 用法：
#   cp deploy/env.production.example server/.env
#   chmod 600 server/.env
#   然后逐项填写。这个文件等价于“服务器钥匙串”，绝不进版本库。
#
# 硬规则：
#   - 任何值都不允许出现在小程序前端（前端只有 config.js 里的 https 域名）
#   - .env 与 .env.local 同时存在时，进程里 .env.local 优先；生产别放 .env.local
# ============================================================

# ---------- 服务 ----------
PORT=8787
# 容器里必须是 0.0.0.0；裸机 + Nginx 反代建议 127.0.0.1（外网进不来）
HOST=127.0.0.1
NODE_ENV=production
# 数据目录（务必放在持久化卷/独立磁盘上，容器重建不能丢）
DATA_DIR=/var/lib/wangju-daka

# ---------- 管理后台 ----------
# 后台入口 /admin.html 的登录令牌。留空 = 后台直接 403（等于关闭）。
# 生成：openssl rand -hex 24
ADMIN_TOKEN=

# ---------- 会话签名 ----------
# 不填则每次重启随机生成，重启后所有用户需要重新登录。生产必须固定。
# 生成：openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_MS=604800000

# ---------- 微信小程序 ----------
WX_APPID=wxe3380ec60a48931d
WX_SECRET=
# 内容安全机审（上线必须 true；false 仅限本地调试）
WX_SEC_CHECK_ENABLED=true

# ---------- 微信虚拟支付（未开通则保持空，前端自动隐藏充值入口）----------
WX_PAY_OFFER_ID=
WX_PAY_APP_KEY=
WX_PAY_MCHID=
# 支付回调必须是 https 公网地址，例如 https://api.example.com/api/pay/notify
WX_PAY_NOTIFY_URL=
# 0=正式 1=沙箱
WX_PAY_ENV=1

# ---------- 算力池：灵悟中转站 ----------
RELAY_GATEWAY=https://api.lingkeai.ai/v1
# 留空 = MOCK 模式（不产生真实消耗），只适合验收演示
RELAY_API_KEY=
RELAY_GATEWAY_BACKUP=
RELAY_MAX_CONCURRENCY=8
RELAY_RPM_LIMIT=240
# 演示/压测时强制 mock：true 时即使有 Key 也不真实调用
RELAY_MOCK=false

# ---------- 计费 ----------
CREDIT_CNY_PER_POINT=1.00
CREDIT_MARKUP=1.35
USD_CNY_RATE=7.10
SUANLI_CNY_RATE=1.00

# ---------- 水位告警 ----------
POOL_WARN_RATIO=0.30
POOL_CRITICAL_RATIO=0.15
POOL_FUSE_RATIO=0.05
POOL_WARN_SUANLI=5
POOL_CRITICAL_SUANLI=2
POOL_FUSE_SUANLI=0.5
POOL_BALANCE_TTL_MS=60000

# ---------- 合规 ----------
AI_LABEL_ENABLED=true
AI_LABEL_TEXT=本作品由人工智能生成

# ---------- 一致性比对服务（可选）----------
# 留空 = 不注册 provider，交付闸门会因“无法证明一致”而阻断（刻意设计）
QC_COMPARE_ENDPOINT=
QC_COMPARE_TOKEN=
QC_COMPARE_TIMEOUT_MS=8000
QC_COMPARE_PROVIDER_NAME=http_clip
