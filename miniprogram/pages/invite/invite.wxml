<view class="screen {{pageAnim ? 'screen-in' : ''}}">
  <view class="aurora">
    <view class="aurora-a"></view>
    <view class="aurora-b"></view>
  </view>

  <view class="layer inv-layer">
    <view class="inv-head">
      <view class="eyebrow">INVITE &amp; EARN</view>
      <view class="h1 mt16">邀请好友，<text class="accent-text">双方有礼</text></view>
      <view class="sub mt8">好友完成首部作品，你自动到账 {{reward}} 点算力。</view>
    </view>

    <!-- 票券式邀请码 -->
    <view class="ticket">
      <view class="ticket-body">
        <view class="between">
          <text class="ticket-label">我的专属邀请码</text>
          <text class="pill pill-gold pill-no-dot">1 点 = ¥1</text>
        </view>
        <view class="code-row tap" hover-class="tap-on" bindtap="copyCode">
          <text class="code-text mono">{{loading ? '——————' : code}}</text>
          <view class="code-btn">复制</view>
        </view>
        <view class="ticket-tip">好友注册时填写此码，完成首部作品后你得 <text class="strong">{{reward}}</text> 点，好友同样获得启动算力。</view>
      </view>

      <view class="ticket-cut">
        <view class="notch notch-l"></view>
        <view class="dash"></view>
        <view class="notch notch-r"></view>
      </view>

      <view class="ticket-foot">
        <view class="tf-cell">
          <view class="tf-value num">{{bRewarded}}</view>
          <view class="tf-label">已到账</view>
        </view>
        <view class="tf-cell">
          <view class="tf-value num">{{bPending}}</view>
          <view class="tf-label">待完成</view>
        </view>
        <view class="tf-cell">
          <view class="tf-value num">{{bPoints}}</view>
          <view class="tf-label">累计点数</view>
        </view>
      </view>

      <view class="ticket-actions">
        <view class="btn btn-sm" bindtap="copyCode">复制邀请码</view>
        <button class="btn btn-sm btn-plain" open-type="share">分享给好友</button>
      </view>
    </view>

    <!-- 有效邀请判定 -->
    <view class="section">
      <view class="row">
        <text class="section-title">有效邀请怎么算</text>
        <text class="section-sub">系统自动判定</text>
      </view>
    </view>
    <view class="card">
      <view class="step">
        <view class="step-rail">
          <view class="step-dot">1</view>
          <view class="step-line"></view>
        </view>
        <view class="step-body">
          <view class="step-title">好友是新用户</view>
          <view class="step-desc">首次注册 24 小时内填写你的邀请码，且还没有创建过作品</view>
        </view>
      </view>
      <view class="step">
        <view class="step-rail">
          <view class="step-dot">2</view>
          <view class="step-line"></view>
        </view>
        <view class="step-body">
          <view class="step-title">绑定关系唯一</view>
          <view class="step-desc">一个账号只能被邀请一次；自己邀请自己、同设备多开不计入</view>
        </view>
      </view>
      <view class="step last">
        <view class="step-rail">
          <view class="step-dot">3</view>
        </view>
        <view class="step-body">
          <view class="step-title">完成首部作品</view>
          <view class="step-desc">{{requireMilestone ? '好友创建第一个项目后，奖励自动到账' : '当前为注册即发模式，由运营配置'}}</view>
        </view>
      </view>
      <view class="notice notice-dark mt16">
        <view class="dot"></view>
        <view class="flex1">同一网络短时间批量注册会被判为无效，奖励自动发放，无需手动领取。</view>
      </view>
    </view>

    <!-- 邀请记录 -->
    <view class="section">
      <view class="row">
        <text class="section-title">邀请记录</text>
        <text class="section-sub" wx:if="{{items.length}}">{{items.length}} 人</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="card">
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line"></view>
      <view class="skeleton sk-line" style="width:60%"></view>
    </view>

    <view wx:elif="{{!items.length}}" class="card empty">
      <view class="empty-icon float">◎</view>
      <view class="empty-title">还没有邀请记录</view>
      <view class="empty-sub">把邀请码发给正在做短剧的朋友，他完成第一部作品你就到账</view>
      <view class="btn btn-sm mt24" bindtap="goCreate">先自己做一部</view>
    </view>

    <view wx:else class="card">
      <view wx:for="{{items}}" wx:key="id" class="inv-item">
        <view class="inv-avatar">{{item.char}}</view>
        <view class="flex1">
          <view class="inv-name">{{item.name}}</view>
          <view class="tiny mt8">{{item.timeText}} · {{item.statusText}}</view>
        </view>
        <text class="pill {{item.cls}}">{{item.points ? '+' + item.points + ' 点' : '待发放'}}</text>
      </view>
    </view>

    <!-- 填写好友邀请码 -->
    <view class="card">
      <view class="between" bindtap="toggleBind">
        <view class="flex1">
          <view class="h3">我也有邀请码</view>
          <view class="tiny mt8">新注册用户可填好友的邀请码，双方各得算力</view>
        </view>
        <text class="link" style="font-size:23rpx">{{showBind ? '收起' : '填写'}}</text>
      </view>
      <view wx:if="{{showBind}}" class="mt24">
        <input class="input" placeholder="输入 6 位邀请码" placeholder-class="input-ph" maxlength="12" value="{{bindCode}}" bindinput="onBindInput" />
        <view class="btn btn-block mt16 {{binding ? 'btn-disabled' : ''}}" bindtap="submitBind">{{binding ? '提交中…' : '绑定邀请关系'}}</view>
        <view class="hint mt16">同一个账号只能绑定一次；老账号、已建过作品的账号无法绑定。</view>
      </view>
    </view>

    <!-- 规则 -->
    <view class="card">
      <view class="section-title">奖励规则</view>
      <view wx:for="{{rules}}" wx:key="*this" class="rule-row">
        <text class="rule-dot">·</text>
        <text class="flex1 rule-text">{{item}}</text>
      </view>
      <view class="hairline"></view>
      <view class="hint">奖励为点数形式，可在创作中抵扣生成消耗，不可提现。作弊所得平台有权撤销并追回。
        <text class="link" bindtap="openLegal">查看用户协议</text>
      </view>
    </view>

    <view class="footer-note">网剧大咖 · 邀请有礼</view>
    <view class="safe-bottom"></view>
  </view>
</view>
