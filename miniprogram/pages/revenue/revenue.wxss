.head { padding: 28rpx 4rpx 18rpx; }
.title { font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.sub { margin-top: 8rpx; font-size: 22rpx; color: #8B95A6; }

.card { padding: 26rpx 24rpx; margin-bottom: 20rpx; }
.card-title { font-size: 23rpx; color: #9AA4B4; margin-bottom: 16rpx; letter-spacing: 1rpx; }

.hero { padding: 30rpx 26rpx; }
.hero-label { font-size: 22rpx; color: #9AA4B4; }
.hero-num {
  margin-top: 8rpx;
  font-size: 76rpx; font-weight: 700; line-height: 1.1;
  color: #F7E4B4; font-variant-numeric: tabular-nums;
  text-shadow: 0 10rpx 40rpx rgba(243, 201, 105, 0.25);
}

.idx {
  margin-right: 8rpx; padding: 0 8rpx; border-radius: 6rpx;
  font-size: 19rpx; color: #E0BD77;
  background: rgba(243, 201, 105, 0.12);
  font-family: "SF Mono", Menlo, monospace;
}

.empty { text-align: center; padding: 44rpx 30rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; }
.empty-sub { margin-top: 12rpx; font-size: 22rpx; line-height: 1.7; color: #8792A3; }
.err { color: #FF8E8E; font-size: 24rpx; }

/* —— 额度预警（V4.5）—— */
.quota-bar {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 24rpx; margin-bottom: 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 142, 142, 0.28);
  background: linear-gradient(150deg, rgba(255, 120, 120, 0.14), rgba(255, 120, 120, 0.03));
}
.quota-bar.low {
  border-color: rgba(243, 201, 105, 0.3);
  background: linear-gradient(150deg, rgba(243, 201, 105, 0.13), rgba(243, 201, 105, 0.02));
}
.quota-main { flex: 1; min-width: 0; }
.quota-title { font-size: 26rpx; font-weight: 700; color: #FFD9D9; }
.quota-bar.low .quota-title { color: #FFE7BC; }
.quota-sub { margin-top: 8rpx; font-size: 21rpx; line-height: 1.55; color: #A9B3C5; }
.quota-btn {
  flex: none; padding: 14rpx 24rpx; border-radius: 999rpx;
  font-size: 23rpx; font-weight: 700; color: #241705;
  background: linear-gradient(128deg, #FFE2A6, #F3C969 55%, #E29B3F);
}

/* —— 待回填 —— */
.fill-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.fill-sub { font-size: 21rpx; color: #8B95A6; }
.fill-btn {
  flex: none; padding: 14rpx 26rpx; border-radius: 999rpx;
  font-size: 23rpx; font-weight: 700; color: #1A1206;
  background: linear-gradient(128deg, #FFE2A6, #F3C969 55%, #E29B3F);
  box-shadow: 0 10rpx 24rpx rgba(226, 155, 63, 0.28);
}

.fill-row { padding: 20rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.07); }
.fill-row:last-child { border-bottom: none; }
.fill-row-top { display: flex; align-items: baseline; gap: 12rpx; }
.fill-row-name { font-size: 25rpx; font-weight: 600; color: #E9EEF7; }
.fill-row-title { flex: 1; min-width: 0; font-size: 20rpx; color: #7E8899; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fill-row-ctrl { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; }
.fill-input {
  flex: 1; height: 76rpx; padding: 0 20rpx;
  border-radius: 16rpx; font-size: 28rpx; color: #FFFFFF;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  font-variant-numeric: tabular-nums;
}
/* 小号分段：没有滑块指示器，on 态直接给底色，否则深色文字落在深色底上会看不清 */
.seg.tiny { flex: none; margin-bottom: 0; padding: 5rpx; border-radius: 16rpx; }
.seg.tiny .seg-item { flex: none; padding: 0 16rpx; height: 66rpx; line-height: 66rpx; font-size: 22rpx; border-radius: 12rpx; }
.seg.tiny .seg-item.on {
  background: linear-gradient(120deg, #FFE2A6, #F3C969 55%, #E8AE55);
  box-shadow: 0 8rpx 20rpx rgba(226, 155, 63, 0.28);
}
