/* 首页：极光 hero + 剧组卡片 */

.stat-strip {
  display: flex;
  align-items: center;
  margin: 34rpx 0 0;
  padding: 24rpx 10rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.045);
  border-color: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.hero-create { border-radius: 34rpx; }
.step-badge {
  width: 46rpx; height: 46rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; font-weight: 800; letter-spacing: 0.5rpx;
  color: #241705;
  background: linear-gradient(140deg, #FFE2A6, #E9AC4C);
  box-shadow: 0 8rpx 18rpx rgba(226, 155, 63, 0.24);
}
.prompt-wrap { position: relative; }
.prompt-area { height: 210rpx; padding-bottom: 44rpx; }
.create-note { text-align: center; font-size: 20rpx; color: #5B6578; margin-top: 18rpx; letter-spacing: 0.5rpx; }

.idea-scroll { width: 100%; white-space: nowrap; }
.idea-chip {
  display: inline-flex; align-items: center;
  max-width: 460rpx;
  padding: 13rpx 22rpx; margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 22rpx; color: #9AA5B8;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.idea-spark { color: #F3C969; font-size: 20rpx; margin-right: 10rpx; }

/* 横向剧组卡 */
.proj-scroll { width: 100%; white-space: nowrap; padding: 4rpx 0 8rpx; }
.proj-card {
  display: inline-block; width: 300rpx; margin-right: 20rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.015));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  vertical-align: top;
}
.proj-cover { height: 300rpx; width: 100%; border-radius: 22rpx; }
.proj-badge {
  position: absolute; top: 12rpx; left: 12rpx; z-index: 2;
  padding: 3rpx 12rpx; border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.42); color: #FFE0A3; font-size: 18rpx;
  border: 1rpx solid rgba(243, 201, 105, 0.35);
}
.proj-title { font-size: 27rpx; font-weight: 650; color: #FFFFFF; margin-top: 16rpx; }
.proj-meta { font-size: 21rpx; color: #6E7A8E; margin-top: 6rpx; }
.proj-foot { display: flex; align-items: center; margin-top: 14rpx; }
.mini-progress { flex: 1; height: 6rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
.mini-progress-bar { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #F7D98F, #E29B3F); transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
.proj-percent { font-size: 21rpx; color: #F3C969; margin-left: 12rpx; }

/* 列表行 */
.proj-row { display: flex; align-items: center; padding: 22rpx; }
.proj-row-cover { width: 128rpx; height: 168rpx; border-radius: 20rpx; flex-shrink: 0; }
.proj-row-char { font-size: 56rpx; font-weight: 800; color: rgba(255, 255, 255, 0.92); }
.proj-row-title { font-size: 29rpx; font-weight: 650; color: #FFFFFF; flex: 1; margin-right: 12rpx; }

/* 四步流程 */
.flow-strip {
  display: flex; align-items: flex-start;
  padding: 26rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.flow-item { width: 118rpx; text-align: center; }
.flow-no {
  width: 44rpx; height: 44rpx; border-radius: 50%; margin: 0 auto 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 18rpx; font-weight: 700; color: #F3C969;
  border: 1rpx solid rgba(243, 201, 105, 0.4);
  background: rgba(243, 201, 105, 0.08);
}
.flow-title { font-size: 23rpx; color: #E2E8F2; font-weight: 600; }
.flow-sub { font-size: 18rpx; color: #626D80; margin-top: 4rpx; }
.flow-line { flex: 1; height: 1rpx; background: linear-gradient(90deg, rgba(243, 201, 105, 0.4), rgba(255, 255, 255, 0.08)); margin-top: 22rpx; }

/* 快捷入口 */
.quick-row { display: flex; }
.quick {
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx 16rpx;
  border-radius: 24rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.quick:last-child { margin-right: 0; }
.quick-icon {
  width: 62rpx; height: 62rpx; margin: 0 auto 12rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #F3C969;
  background: rgba(243, 201, 105, 0.1);
  border: 1rpx solid rgba(243, 201, 105, 0.22);
}
.quick-text { font-size: 22rpx; color: #C6CFDD; }

.dot-sep { color: #3E4757; margin: 0 8rpx; }
.privacy-links { margin-top: 20rpx; font-size: 23rpx; }
.privacy-later { text-align: center; font-size: 23rpx; color: #626D80; margin-top: 24rpx; }

/* —— 索引编号（同名剧靠它区分） —— */
.idx-tag {
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  color: #E0BD77;
  background: rgba(243, 201, 105, 0.12);
  font-family: "SF Mono", Menlo, monospace;
}
