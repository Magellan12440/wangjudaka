<view class="screen {{pageAnim ? 'screen-in' : ''}}">
  <view class="aurora">
    <view class="aurora-a"></view>
    <view class="aurora-b"></view>
  </view>

  <view class="layer" style="padding: 20rpx 32rpx 0">
    <view class="between">
      <view>
        <view class="eyebrow">NEW PRODUCTION</view>
        <view class="h1" style="margin-top:12rpx">新建项目</view>
      </view>
      <view class="step-count num">0{{step}}<text class="step-total">/02</text></view>
    </view>

    <view class="steps">
      <view class="step-node {{step >= 1 ? 'on' : ''}}">
        <view class="step-dot">1</view>
        <text class="step-name">剧名</text>
      </view>
      <view class="step-track"><view class="step-track-fill" style="width:{{step >= 2 ? 100 : 0}}%"></view></view>
      <view class="step-node {{step >= 2 ? 'on' : ''}}">
        <view class="step-dot">2</view>
        <text class="step-name">设定</text>
      </view>
    </view>

    <!-- STEP 1：先决定故事从哪来，再填剧名 -->
    <block wx:if="{{step === 1}}">
      <view class="h2 mt24">这个故事从哪来</view>
      <view class="sub mt8">两条路都能拍。手上有现成的就选改编——系统会沿用你的人物和世界观，不另起炉灶。</view>

      <view class="origin-row mt16">
        <view
          wx:for="{{origins}}"
          wx:key="key"
          class="origin-card {{origin === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="pickOrigin"
        >
          <view class="origin-icon">{{item.icon}}</view>
          <view class="origin-label">{{item.label}}</view>
          <view class="origin-sub">{{item.sub}}</view>
        </view>
      </view>

      <view class="card mt16 rise d1">
        <view class="field-label"><text>剧名</text><text class="opt">必填 · 最多 30 字</text></view>
        <input
          class="input {{typing ? 'input-focus' : ''}}"
          style="font-size:34rpx;height:104rpx;font-weight:600"
          placeholder="例如：长夜执灯人"
          placeholder-class="input-ph"
          value="{{title}}"
          maxlength="30"
          bindinput="onTitle"
          bindfocus="onFocus"
          bindblur="onBlur"
          cursor-spacing="140"
        />

        <!-- 改编路线：正文才是真正的创作输入 -->
        <block wx:if="{{origin === 'material'}}">
          <view class="field-label mt24">
            <text>你的正文</text>
            <text class="opt">{{scriptChars}} 字 · 至少 {{minAdaptChars}}</text>
          </view>
          <view class="prompt-wrap">
            <textarea
              class="textarea prompt-area adapt-area"
              placeholder="把你小说/剧本的正文贴进来。系统会沿用里面的人物关系、世界观和关键情节来拆分剧集，而不是重新编一个。"
              placeholder-class="input-ph"
              value="{{scriptText}}"
              maxlength="20000"
              bindinput="onScriptText"
              bindfocus="onFocus"
              bindblur="onBlur"
              cursor-spacing="160"
              show-confirm-bar="{{false}}"
            />
            <view class="counter {{scriptChars && scriptChars < minAdaptChars ? 'warn' : ''}}">{{scriptChars}}/20000</view>
          </view>
          <view class="adapt-tools">
            <view class="ghost-mini tap" hover-class="tap-on" bindtap="pickScriptFile">从聊天选 TXT</view>
            <text class="tiny" wx:if="{{scriptName}}">{{scriptName}}</text>
            <text class="tiny" wx:else>DOCX 建组后可在素材页选，自动取正文</text>
          </view>

          <view class="field-label mt24"><text>改到什么程度</text><text class="opt">决定 AI 的改写权限</text></view>
          <view class="type-list">
            <view
              wx:for="{{adaptModes}}"
              wx:key="key"
              class="type-card {{adaptMode === item.key ? 'on' : ''}}"
              data-key="{{item.key}}"
              bindtap="pickAdaptMode"
            >
              <view class="type-radio {{adaptMode === item.key ? 'on' : ''}}"></view>
              <view class="flex1">
                <view class="type-name">{{item.label}}</view>
                <view class="type-sub">{{item.sub}}</view>
              </view>
            </view>
          </view>

          <view class="field-label mt24"><text>这次改编的要点</text><text class="opt">选填 · 之后可改</text></view>
          <view class="prompt-wrap">
            <textarea
              class="textarea"
              style="height:140rpx"
              placeholder="例如：只拍前三章；男主性格再狠一点；把双男主改成一人分饰"
              placeholder-class="input-ph"
              value="{{prompt}}"
              maxlength="300"
              bindinput="onInput"
              bindfocus="onFocus"
              bindblur="onBlur"
              cursor-spacing="160"
              show-confirm-bar="{{false}}"
            />
          </view>
        </block>

        <!-- AI 出创意：原来的路径，一个字没动 -->
        <block wx:else>
          <view class="field-label mt24"><text>一句话创意</text><text class="opt">选填 · 之后可改</text></view>
          <view class="prompt-wrap">
            <textarea
              class="textarea prompt-area"
              placeholder="不说也行。上传小说正文或参考图后，系统会按素材来写。"
              placeholder-class="input-ph"
              value="{{prompt}}"
              maxlength="300"
              bindinput="onInput"
              bindfocus="onFocus"
              bindblur="onBlur"
              cursor-spacing="160"
              show-confirm-bar="{{false}}"
            />
            <view class="counter {{prompt.length > 260 ? 'warn' : ''}}">{{prompt.length}}/300</view>
          </view>

          <view class="field-label mt16"><text>没灵感？点一个开头</text><text class="opt">可直接改</text></view>
          <view class="idea-grid">
            <view wx:for="{{ideas}}" wx:key="*this" class="idea-card tap" hover-class="tap-on" data-text="{{item}}" bindtap="pickIdea">
              <text class="idea-no">0{{index + 1}}</text>
              <text class="idea-text">{{item}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="notice">
        <view class="dot"></view>
        <view class="flex1">剧名与创意会经过内容安全机审。请勿输入违法、暴力、色情或侵犯他人权益的内容。</view>
      </view>

      <view class="btn btn-block mt32 {{canCreate ? 'tap' : 'btn-disabled'}}" hover-class="{{canCreate ? 'tap-on' : ''}}" bindtap="next">{{origin === 'material' ? '下一步：选风格与配比' : '下一步：选设定'}}</view>
      <view class="footer-note">{{origin === 'material' ? '正文只用于本剧创作，不公开、不外传' : '这一步不产生任何点数消耗'}}</view>
    </block>

    <!-- STEP 2：设定 + 模型 + 剧壳 -->
    <block wx:else>
      <view class="between mt24">
        <view class="h2">《{{title}}》怎么拍</view>
        <view class="tiny">全部可后改</view>
      </view>

      <view class="card mt24">
        <view class="field-label"><text>风格</text><text class="opt">{{styleName}}</text></view>
        <view class="chips">
          <block wx:for="{{styles}}" wx:key="code">
            <view
              wx:if="{{showAllStyles || index < 8 || item.code === styleCode}}"
              class="chip {{styleCode === item.code ? 'on' : ''}}"
              data-field="styleCode"
              data-value="{{item.code}}"
              bindtap="pick"
            >{{item.name}}</view>
          </block>
          <view wx:if="{{styles.length > 8}}" class="chip" data-field="styleCode" data-value="{{styleCode}}" bindtap="toggleAllStyles">{{showAllStyles ? '收起' : '全部 ' + styles.length + ' 种（含古风/仙侠/修真）'}}</view>
        </view>
        <view wx:if="{{stylesError}}" class="hint mt8">{{stylesError}}</view>
      </view>

      <view class="card mt16">
        <view class="field-label"><text>画幅</text><text class="opt">决定发哪个平台</text></view>
        <view class="opt-grid">
          <view wx:for="{{aspectOpts}}" wx:key="key" class="opt-card {{aspect === item.key ? 'on' : ''}}" data-field="aspect" data-value="{{item.key}}" bindtap="pick">
            <view class="opt-main">{{item.label}}</view>
            <view class="opt-sub">{{item.sub}}</view>
          </view>
        </view>

        <view class="field-label mt24"><text>画质</text><text class="opt">{{quality}}</text></view>
        <view class="chips">
          <view wx:for="{{qualityOpts}}" wx:key="key" class="chip {{quality === item.key ? 'on' : ''}}" data-field="quality" data-value="{{item.key}}" bindtap="pick">{{item.label}}</view>
        </view>
      </view>

      <view class="card mt16">
        <view class="field-label"><text>剧集数量</text><text class="opt">共 {{episodeCount}} 集</text></view>
        <view class="chips">
          <view wx:for="{{episodeCountOpts}}" wx:key="*this" class="chip {{episodeCount === item ? 'on' : ''}}" data-field="episodeCount" data-value="{{item}}" bindtap="pick">{{item}} 集</view>
        </view>

        <view class="field-label mt24"><text>单集时长</text><text class="opt">{{episodeSec}} 秒</text></view>
        <view class="chips">
          <view wx:for="{{episodeSecOpts}}" wx:key="*this" class="chip {{episodeSec === item ? 'on' : ''}}" data-field="episodeSec" data-value="{{item}}" bindtap="pick">{{item}}s</view>
        </view>

        <view class="field-label mt24"><text>成片形态</text><text class="opt">影响成本</text></view>
        <view class="type-list">
          <view wx:for="{{typeOpts}}" wx:key="key" class="type-card {{videoType === item.key ? 'on' : ''}}" data-field="videoType" data-value="{{item.key}}" bindtap="pick">
            <view class="type-radio {{videoType === item.key ? 'on' : ''}}"></view>
            <view class="flex1">
              <view class="type-name">{{item.label}}</view>
              <view class="type-sub">{{item.sub}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 模型：每环节前五 -->
      <view class="card mt16">
        <view class="between">
          <view class="field-label" style="margin-bottom:0"><text>用哪些模型</text></view>
          <view class="tiny">仅显示已实测可用</view>
        </view>
        <view wx:for="{{modelRoles}}" wx:key="key" class="mt24">
          <view class="field-label" style="margin-bottom:10rpx">
            <text>{{item.name}}</text>
            <text class="opt">{{item.hint}}</text>
          </view>
          <view class="chips">
            <view
              wx:for="{{item.items}}"
              wx:for-item="m"
              wx:key="code"
              class="chip {{m.on ? 'on' : ''}}"
              data-role="{{item.key}}"
              data-code="{{m.code}}"
              bindtap="pickModel"
            >{{m.label}}</view>
          </view>
        </view>

        <view wx:if="{{editProfiles.length}}" class="field-label mt24"><text>剪辑成片</text><text class="opt">字幕/混音/编码档位</text></view>
        <view class="chips">
          <view wx:for="{{editProfiles}}" wx:key="code" class="chip {{editProfile === item.code ? 'on' : ''}}" data-code="{{item.code}}" bindtap="pickEditProfile">{{item.label}}</view>
        </view>
        <view class="hint mt8">全站统一计费：实际算力消耗 ×{{billingMultiplier}} 扣点，先预扣、按实际结算多退少补。</view>
      </view>

      <!-- 剧壳 -->
      <view class="auto-row tap" hover-class="tap-on" bindtap="toggleShell">
        <view class="auto-box {{shellEnabled ? 'on' : ''}}">{{shellEnabled ? '✓' : ''}}</view>
        <view class="flex1">
          <view class="auto-title">生成剧壳（片头 + 片尾）</view>
          <view class="auto-sub">系列剧的独特标识：片名卡、片尾引导。进项目后可改文案并单独生成。</view>
        </view>
      </view>

      <view class="proposal" wx:if="{{quote}}">
        <view class="proposal-top">
          <text class="proposal-kicker">ESTIMATE</text>
          <text class="pill pill-gold">{{episodeCount}} 集</text>
        </view>
        <view class="proposal-title">按当前设定，整部剧预估消耗</view>
        <view class="price-row">
          <view class="price-value num">{{quote.credits_text}}<text class="price-unit">点</text></view>
          <view class="price-cny">≈ ¥{{quote.cny_text || quote.credits_text}}</view>
        </view>
        <view class="price-note">预估 {{quote.time_text || '—'}} · 实际按每集真实消耗结算，余额不足会暂停在当前集</view>
      </view>
      <view wx:elif="{{quoteLoading}}" class="hint mt16">正在估算点数…</view>

      <view class="notice mt24">
        <view class="dot"></view>
        <view class="flex1">建组后先上传素材（小说/参考图/视频），再生成剧本；每集可单独出片，也可以开托管自动逐集生成。</view>
      </view>

      <view class="btn btn-block mt24 {{creating ? 'btn-disabled' : 'tap'}}" hover-class="{{creating ? '' : 'tap-on'}}" bindtap="create">
        {{creating ? '正在创建…' : '开机，进入剧组'}}
      </view>
      <view class="btn btn-block btn-ghost mt16 tap" hover-class="tap-on" bindtap="back">返回改剧名</view>
      <view class="balance-line">当前余额 {{balance}} 点</view>
      <view class="footer-note">创建项目本身不扣点；生成剧本与画面时才按实际消耗计费</view>
    </block>
  </view>

  <view wx:if="{{creating}}" class="creating-mask">
    <view class="creating-card">
      <view class="creating-orbit">
        <view class="orbit-ring orbit-1"></view>
        <view class="orbit-ring orbit-2"></view>
        <view class="orbit-core">剧</view>
      </view>
      <view class="h3 mt24">正在建组</view>
      <view class="hint mt8">{{createPhase}}… {{elapsed}}s</view>
    </view>
  </view>
</view>
