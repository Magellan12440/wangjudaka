/* ============================================================
   分发收益排行榜 · 夜戏设计系统
   ============================================================ */

.rank-layer { padding: 20rpx 28rpx 60rpx; box-sizing: border-box; }

.rank-head { padding: 8rpx 4rpx 24rpx; }

.rank-meta { display: flex; flex-wrap: wrap; }
.meta-chip {
  font-size: 21rpx; color: #6E7B8E; line-height: 1;
  padding: 12rpx 18rpx; margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx; background: #FFFFFF;
  border: 1rpx solid rgba(22, 35, 58, 0.07);
}
.meta-chip.tap { color: #C57A1E; border-color: rgba(232, 162, 74, 0.32); background: #FFF9F1; }

/* —— 我的位置 —— */
.me-card { padding: 26rpx 28rpx; }
.me-amount {
  font-size: 54rpx; color: #16233A; line-height: 1.2; margin-top: 6rpx;
  letter-spacing: -0.5rpx;
}
.me-rank { text-align: right; }
.me-rank-v {
  display: block; font-size: 46rpx; font-weight: 800; color: #E08A22; line-height: 1.1;
}
.me-rank-l { font-size: 20rpx; color: #9AA5B5; letter-spacing: 1rpx; }
.me-line { display: flex; align-items: center; }
.me-actions { display: flex; gap: 16rpx; }
.me-actions .btn { flex: 1; }
.ml8 { margin-left: 8rpx; }

/* —— 榜单单 —— */
.board {
  margin-top: 24rpx;
  background: #FFFFFF; border-radius: 28rpx;
  border: 1rpx solid rgba(22, 35, 58, 0.06);
  box-shadow: 0 18rpx 44rpx -30rpx rgba(22, 35, 58, 0.4);
  overflow: hidden;
}
.board-head {
  display: flex; align-items: center;
  padding: 20rpx 28rpx;
  background: #F8FAFE;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.05);
}
.board-head text { font-size: 21rpx; color: #8B95A5; letter-spacing: 1rpx; }

.board-row {
  display: flex; align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.045);
}
.board-row:last-child { border-bottom: none; }
.board-top { background: linear-gradient(90deg, rgba(255, 244, 228, 0.72), rgba(255, 255, 255, 0)); }

.col-rank { width: 78rpx; flex-shrink: 0; }
.col-amt { width: 190rpx; flex-shrink: 0; text-align: right; }

.rank-no { font-size: 28rpx; color: #7C8798; }
.rank-badge {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 800; color: #FFFFFF;
  font-family: "DIN Alternate", sans-serif;
}
.rank-badge.gold { background: linear-gradient(140deg, #FFCE7A, #E8901E); box-shadow: 0 6rpx 14rpx -6rpx rgba(232, 144, 30, 0.9); }
.rank-badge.silver { background: linear-gradient(140deg, #D5DEEA, #97A6B8); }
.rank-badge.bronze { background: linear-gradient(140deg, #E7B98D, #C08350); }

.ava {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #EDF3FF; flex-shrink: 0;
}
.ava-text {
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #3A6BE0;
}
.name { font-size: 27rpx; font-weight: 600; color: #16233A; max-width: 300rpx; }
.me-card .name { max-width: none; }

.trend { font-size: 20rpx; font-weight: 700; margin-left: 8rpx; }
.trend.up { color: #D8453C; }
.trend.down { color: #15955F; }
.trend.new { color: #C57A1E; }

.amt { font-size: 30rpx; font-weight: 700; color: #E08A22; letter-spacing: -0.2rpx; }

.board-foot { padding: 22rpx 28rpx 26rpx; text-align: center; background: #FCFDFF; }

.empty-card { padding: 32rpx 30rpx; margin-top: 24rpx; }

/* —— 口径说明 —— */
.rank-note { margin-top: 28rpx; padding: 24rpx 28rpx 8rpx; }
.note-item { display: flex; align-items: flex-start; margin-top: 10rpx; }
.bullet {
  font-size: 26rpx; color: #E8A24A; font-weight: 800;
  margin-right: 10rpx; line-height: 1.5;
}
