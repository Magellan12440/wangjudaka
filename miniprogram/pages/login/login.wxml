<view class="screen login {{pageAnim ? 'screen-in' : ''}}">
  <view class="aurora">
    <view class="aurora-a"></view>
    <view class="aurora-b"></view>
    <view class="aurora-c"></view>
  </view>

  <view class="layer">
    <view class="brand">
      <view class="brand-mark">网</view>
      <view class="brand-name">网剧大咖</view>
      <view class="brand-slogan">输入一个剧名，剩下的交给流水线</view>
    </view>

    <view class="glass card">
      <view class="seg">
        <view class="seg-item {{mode === 'wechat' ? 'on' : ''}}" data-mode="wechat" bindtap="switchMode">微信一键登录</view>
        <view class="seg-item {{mode === 'code' ? 'on' : ''}}" data-mode="code" bindtap="switchMode">验证码</view>
        <view class="seg-item {{mode === 'password' ? 'on' : ''}}" data-mode="password" bindtap="switchMode">密码</view>
      </view>

      <!-- 微信 -->
      <block wx:if="{{mode === 'wechat'}}">
        <view class="wx-hint">用微信授权登录，不需要记密码。换手机时可在「我的 → 账号安全」绑定手机号找回。</view>
        <view class="btn btn-block tap {{busy ? 'btn-disabled' : ''}}" hover-class="tap-on" bindtap="wechatLogin">
          {{busy ? '登录中…' : '微信一键登录'}}
        </view>
      </block>

      <!-- 验证码 -->
      <block wx:elif="{{mode === 'code'}}">
        <view class="field {{focusField === 'phone' ? 'focus' : ''}}">
          <input class="field-input" type="number" maxlength="11" value="{{phone}}" placeholder="手机号"
                 placeholder-class="field-ph" data-field="phone" bindinput="onPhone"
                 bindfocus="onFocus" bindblur="onBlur" />
        </view>
        <view class="field {{focusField === 'code' ? 'focus' : ''}}">
          <input class="field-input" type="number" maxlength="6" value="{{code}}" placeholder="6 位验证码"
                 placeholder-class="field-ph" data-field="code" bindinput="onCode"
                 bindfocus="onFocus" bindblur="onBlur" />
          <view class="field-btn {{countdown > 0 ? 'off' : ''}}" bindtap="sendCode">
            {{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中…' : '获取验证码')}}
          </view>
        </view>
        <view wx:if="{{devCode}}" class="dev-code">
          <text class="tag gold">测试码</text>
          <text class="dev-num">{{devCode}}</text>
          <text class="dev-note">{{devNote}}</text>
        </view>
        <view class="btn btn-block mt24 tap {{busy ? 'btn-disabled' : ''}}" hover-class="tap-on" bindtap="loginByCode">
          {{busy ? '登录中…' : '登录 / 注册'}}
        </view>
        <view class="hint mt12">未注册的手机号验证通过后会自动创建账号，同时开立点数账户</view>
      </block>

      <!-- 密码 -->
      <block wx:else>
        <view class="field {{focusField === 'phone' ? 'focus' : ''}}">
          <input class="field-input" type="number" maxlength="11" value="{{phone}}" placeholder="手机号"
                 placeholder-class="field-ph" data-field="phone" bindinput="onPhone"
                 bindfocus="onFocus" bindblur="onBlur" />
        </view>
        <view class="field {{focusField === 'pwd' ? 'focus' : ''}}">
          <input class="field-input" password value="{{password}}" placeholder="密码（至少 6 位）"
                 placeholder-class="field-ph" data-field="pwd" bindinput="onPassword"
                 bindfocus="onFocus" bindblur="onBlur" />
        </view>
        <view class="btn btn-block mt24 tap {{busy ? 'btn-disabled' : ''}}" hover-class="tap-on" bindtap="loginByPassword">
          {{busy ? '登录中…' : '登录'}}
        </view>
        <view class="hint mt12">还没设过密码？先用「验证码」登录，再在「我的 → 账号安全」里设置密码。</view>
      </block>

      <view wx:if="{{error}}" class="err">{{error}}</view>
    </view>

    <view class="agree" bindtap="toggleAgree">
      <view class="checkbox {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
      <view class="agree-text">
        已阅读并同意
        <text class="link" catchtap="openLegal" data-type="terms">《用户协议》</text>
        与
        <text class="link" catchtap="openLegal" data-type="privacy">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
