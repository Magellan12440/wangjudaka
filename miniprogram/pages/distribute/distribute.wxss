/* ============================================================
   分发与收益 · 夜戏设计系统 v2
   ============================================================ */

.dist-layer { padding: 20rpx 28rpx 60rpx; box-sizing: border-box; }

.dist-head { padding: 8rpx 4rpx 26rpx; animation: rise 0.5s cubic-bezier(0.16, 0.84, 0.28, 1) both; }

/* —— 项目选择 —— */
.proj-scroll { white-space: nowrap; margin: 0 0 22rpx; padding: 4rpx 0 12rpx; }
.proj-chip {
  display: inline-flex; align-items: center; vertical-align: top;
  padding: 12rpx 20rpx 12rpx 12rpx; margin-right: 16rpx;
  background: rgba(22, 35, 58, 0.035);
  border: 1rpx solid rgba(22, 35, 58, 0.075);
  border-radius: 22rpx; max-width: 430rpx;
  transition: border-color 0.2s, background 0.2s, transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.proj-chip.on {
  border-color: rgba(232, 145, 47, 0.62);
  background: rgba(232, 145, 47, 0.09);
  box-shadow: 0 12rpx 30rpx rgba(232, 145, 47, 0.12);
}
.pchip-cover {
  width: 64rpx; height: 84rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 800; color: rgba(255, 255, 255, 0.94);
  margin-right: 16rpx; flex-shrink: 0;
  box-shadow: inset 0 1rpx 0 rgba(22, 35, 58, 0.22);
}
.pchip-main { display: flex; flex-direction: column; min-width: 0; }
.pchip-title {
  font-size: 25rpx; color: #22314A; font-weight: 600;
  max-width: 268rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* —— 看板 —— */
.board-card {
  position: relative; overflow: hidden;
  padding: 28rpx 26rpx 22rpx; border-radius: 30rpx;
  background:
    radial-gradient(120% 90% at 100% 0%, rgba(232, 145, 47, 0.14), transparent 62%),
    linear-gradient(158deg, rgba(22, 35, 58, 0.055), rgba(22, 35, 58, 0.012));
  border: 1rpx solid rgba(22, 35, 58, 0.08);
  box-shadow: 0 22rpx 50rpx rgba(20, 32, 55, 0.34);
  animation: rise 0.56s cubic-bezier(0.16, 0.84, 0.28, 1) 0.05s both;
}
.board-grid { display: flex; margin-top: 22rpx; }
.bg-cell {
  flex: 1; text-align: center; position: relative;
  padding: 4rpx 0;
}
.bg-cell + .bg-cell::before {
  content: ""; position: absolute; left: 0; top: 8rpx; bottom: 8rpx; width: 1rpx;
  background: linear-gradient(180deg, transparent, rgba(22, 35, 58, 0.14), transparent);
}
.bg-value { font-size: 38rpx; font-weight: 800; color: #16233A; letter-spacing: 0.4rpx; line-height: 1.15; }
.bg-label { font-size: 20rpx; color: #8B95A5; margin-top: 8rpx; letter-spacing: 1rpx; }
.board-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }

/* —— 平台入口 —— */
.pf-grid { display: flex; flex-wrap: wrap; }
.pf-cell {
  width: 25%; display: flex; flex-direction: column; align-items: center;
  margin-bottom: 26rpx;
  animation: rise 0.46s cubic-bezier(0.16, 0.84, 0.28, 1) both;
}
.pf-cell:nth-child(1) { animation-delay: 0.03s; }
.pf-cell:nth-child(2) { animation-delay: 0.06s; }
.pf-cell:nth-child(3) { animation-delay: 0.09s; }
.pf-cell:nth-child(4) { animation-delay: 0.12s; }
.pf-cell:nth-child(5) { animation-delay: 0.15s; }
.pf-cell:nth-child(6) { animation-delay: 0.18s; }
.pf-cell:nth-child(7) { animation-delay: 0.21s; }
.pf-cell:nth-child(8) { animation-delay: 0.24s; }
.pf {
  width: 86rpx; height: 86rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 800; color: #16233A;
  margin-right: 16rpx;
  box-shadow: 0 14rpx 32rpx rgba(20, 32, 55, 0.34), inset 0 2rpx 0 rgba(22, 35, 58, 0.28);
}
.pf-cell .pf { margin-right: 0; margin-bottom: 12rpx; }
.pf-sm { width: 66rpx; height: 66rpx; border-radius: 20rpx; font-size: 27rpx; margin-right: 16rpx; }
.pf-a { background: linear-gradient(145deg, #D8453C, #C93F37); }
.pf-b { background: linear-gradient(145deg, #C3CCDA, #FFFFFF); }
.pf-c { background: linear-gradient(145deg, #FF9A45, #D9511E); }
.pf-d { background: linear-gradient(145deg, #3A7BE0, #1C4FD6); }
.pf-e { background: linear-gradient(145deg, #2FA9D6, #0F7FB3); }
.pf-f { background: linear-gradient(145deg, #FB7A34, #D9511E); }
.pf-g { background: linear-gradient(145deg, #D8453C, #C4373F); }
.pf-h { background: linear-gradient(145deg, #D8453C, #BE2F55); }
.pf-name {
  font-size: 20rpx; color: #6E7B8E; max-width: 140rpx; text-align: center;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* —— 任务卡 —— */
.task-card {
  padding: 24rpx; margin-bottom: 18rpx; border-radius: 26rpx;
  background: linear-gradient(158deg, rgba(22, 35, 58, 0.045), rgba(22, 35, 58, 0.01));
  border: 1rpx solid rgba(22, 35, 58, 0.075);
}
.task-main { min-width: 0; flex: 1; }
.task-name { font-size: 27rpx; color: #16233A; font-weight: 600; }
.task-data {
  display: flex; margin-top: 20rpx; padding: 18rpx 0;
  border-top: 1rpx solid rgba(22, 35, 58, 0.06);
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.06);
}
.td { flex: 1; text-align: center; }
.td-v { font-size: 30rpx; color: #22314A; font-weight: 700; }
.td-l { font-size: 19rpx; color: #8B95A5; margin-top: 4rpx; }
.task-actions { display: flex; margin-top: 18rpx; }
.task-actions .btn { flex: 1; margin-right: 12rpx; height: 60rpx; font-size: 22rpx; }
.task-actions .btn:last-child { margin-right: 0; }

/* —— 选择器 —— */
.picker {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(20, 32, 55, 0.28);
  border: 1rpx solid rgba(22, 35, 58, 0.085);
  border-radius: 18rpx; padding: 22rpx 24rpx;
  font-size: 26rpx; color: #3A4658;
}
.picker-arrow { color: #8B95A5; font-size: 32rpx; }

/* —— 测算 —— */
.calc-row { display: flex; }
.calc-field { flex: 1; margin-right: 16rpx; }
.calc-field:last-child { margin-right: 0; }
.calc-input { margin-top: 8rpx; }

.calc-result {
  margin-top: 22rpx; padding: 24rpx;
  background: linear-gradient(158deg, rgba(232, 145, 47, 0.12), rgba(232, 145, 47, 0.02));
  border: 1rpx solid rgba(232, 145, 47, 0.26);
  border-radius: 22rpx;
}
.calc-main { display: flex; align-items: baseline; justify-content: space-between; margin-top: 16rpx; }
.calc-label { font-size: 22rpx; color: #B08A4E; }
.calc-value { font-size: 50rpx; font-weight: 800; color: #E08A22; letter-spacing: -0.5rpx; }
.calc-sub { display: flex; justify-content: space-between; font-size: 21rpx; color: #8B95A5; margin-top: 10rpx; }

/* —— 键值行 —— */
.kv {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.05);
}
.kv-k { font-size: 24rpx; color: #8B95A5; width: 140rpx; flex-shrink: 0; }
.kv-v { font-size: 24rpx; color: #3A4658; text-align: right; flex: 1; line-height: 1.5; }

.tips { margin-top: 18rpx; }

/* —— 四步闭环 —— */
.steps {
  margin-top: 20rpx; padding-top: 18rpx;
  border-top: 1rpx solid rgba(22, 35, 58, 0.06);
}
.steps-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.steps-title { font-size: 21rpx; color: #8B95A5; letter-spacing: 1rpx; }
.steps-count { font-size: 20rpx; color: #E08A22; font-weight: 700; }
.step {
  display: flex; align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.04);
}
.step:last-child { border-bottom: none; }
.step-dot {
  flex: none; width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700; margin-right: 16rpx;
  background: rgba(22, 35, 58, 0.05); color: #8B95A5;
  border: 1rpx solid rgba(22, 35, 58, 0.1);
}
.step-dot.st-done { background: rgba(84, 209, 143, 0.16); color: #22B07D; border-color: rgba(84, 209, 143, 0.42); }
.step-dot.st-cur { background: rgba(232, 145, 47, 0.18); color: #C57A1E; border-color: rgba(232, 145, 47, 0.5); }
.step-dot.st-bad { background: rgba(242, 108, 108, 0.16); color: #D8453C; border-color: rgba(242, 108, 108, 0.45); }
.step-line { display: flex; align-items: center; }
.step-name { font-size: 24rpx; color: #2A3446; font-weight: 600; }
.step-state { font-size: 19rpx; margin-left: 12rpx; color: #8B95A5; }
.step-state.st-done { color: #22B07D; }
.step-state.st-cur { color: #C57A1E; }
.step-state.st-bad { color: #D8453C; }
.step-note {
  font-size: 20rpx; color: #8B95A5; margin-top: 4rpx; line-height: 1.5;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 380rpx;
}
.step-act { flex: none; font-size: 21rpx; color: #E08A22; margin-left: 12rpx; }

/* —— 资料包文件清单 —— */
.file-row {
  display: flex; align-items: center;
  margin-top: 12rpx; padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(20, 32, 55, 0.32);
}
.file-type {
  flex: none; width: 76rpx;
  font-size: 20rpx; font-weight: 700; color: #C57A1E; letter-spacing: 1rpx;
}
.file-url {
  flex: 1; min-width: 0;
  font-size: 21rpx; color: #4A566B;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* —— V4.4 收益看板入口 —— */
.rev-entry {
  display: flex; align-items: center; gap: 12rpx;
  margin-top: 20rpx; padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, rgba(126, 102, 255, 0.16), rgba(22, 35, 58, 0.03));
  border: 1rpx solid rgba(126, 102, 255, 0.28);
}
.rev-entry-icon { font-size: 26rpx; color: #6B57D6; }
.rev-entry-text { font-size: 26rpx; font-weight: 600; color: #4A3FB0; }
.rev-entry-sub { flex: 1; text-align: right; font-size: 20rpx; color: #6B5FC4; }

/* 排行榜入口：金橙色，和紫色的收益看板区分 */
.rank-entry {
  background: linear-gradient(120deg, rgba(232, 162, 74, 0.18), rgba(22, 35, 58, 0.03));
  border-color: rgba(232, 162, 74, 0.34);
}
.rank-entry .rev-entry-icon { color: #C57A1E; }
.rank-entry .rev-entry-text { color: #A8620F; }
.rank-entry .rev-entry-sub { color: #9A6B2A; }
