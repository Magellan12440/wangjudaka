/* ============================================================
   网剧大咖 · 设计系统 v2「夜戏」
   深空黑 + 香槟金 + 极光紫 / 玻璃卡片 / 大幅排版 / 有呼吸的动效
   —— 目标不是"好看"，是让人相信这里能拍出片子
   ============================================================ */

page {
  background: #06070C;
  color: #F2F5FB;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* —— 画布 / 背景 —— */
.screen {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 注意：这里不能用 overflow-x: hidden —— 它会让 .screen 变成横向滚动容器，
     内部 position: sticky 的吸顶导航随即失效（sticky 相对不滚动的 scrollport）。
     clip 只裁剪、不建立滚动容器，sticky 才能正常工作。 */
  overflow-x: clip;
}
.page { min-height: 100vh; padding: 0 28rpx 60rpx; box-sizing: border-box; }
.page-flush { min-height: 100vh; padding-bottom: 60rpx; }
.screen-in { animation: pageIn 0.46s cubic-bezier(0.16, 0.84, 0.28, 1) both; }
@keyframes pageIn {
  from { opacity: 0; transform: translate3d(0, 22rpx, 0) scale(0.995); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

/* 极光：三团缓慢漂移的光，给纯黑底一点"空气" */
.aurora { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
.aurora view { position: absolute; border-radius: 50%; filter: blur(46rpx); opacity: 0.55; }
.aurora-a {
  width: 620rpx; height: 620rpx; top: -240rpx; right: -180rpx;
  background: radial-gradient(circle at 30% 30%, rgba(243, 201, 105, 0.55), rgba(243, 201, 105, 0) 68%);
  animation: driftA 18s ease-in-out infinite alternate;
}
.aurora-b {
  width: 560rpx; height: 560rpx; top: 120rpx; left: -260rpx;
  background: radial-gradient(circle at 50% 50%, rgba(126, 102, 255, 0.42), rgba(126, 102, 255, 0) 70%);
  animation: driftB 22s ease-in-out infinite alternate;
}
.aurora-c {
  width: 480rpx; height: 480rpx; top: 520rpx; right: -160rpx;
  background: radial-gradient(circle at 50% 50%, rgba(64, 199, 224, 0.28), rgba(64, 199, 224, 0) 70%);
  animation: driftC 26s ease-in-out infinite alternate;
}
@keyframes driftA { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(-40rpx, 60rpx, 0) scale(1.12); } }
@keyframes driftB { from { transform: translate3d(0, 0, 0) scale(1.05); } to { transform: translate3d(50rpx, -70rpx, 0) scale(0.92); } }
@keyframes driftC { from { transform: translate3d(0, 0, 0) scale(0.95); } to { transform: translate3d(-30rpx, -50rpx, 0) scale(1.1); } }

.layer { position: relative; z-index: 1; }

/* —— 布局 —— */
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.center { display: flex; align-items: center; justify-content: center; }
.flex1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.gap8 { height: 8rpx; } .gap16 { height: 16rpx; } .gap24 { height: 24rpx; } .gap32 { height: 32rpx; }
.mt8 { margin-top: 8rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; } .mt32 { margin-top: 32rpx; }
.mb8 { margin-bottom: 8rpx; } .mb16 { margin-bottom: 16rpx; } .mb24 { margin-bottom: 24rpx; }
.pad { padding: 0 32rpx; box-sizing: border-box; }
.safe-bottom { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* —— 文字 —— */
.display { font-size: 64rpx; font-weight: 800; line-height: 1.12; letter-spacing: -1rpx; color: #FFFFFF; }
.h1 { font-size: 46rpx; font-weight: 750; letter-spacing: 0.5rpx; color: #FFFFFF; line-height: 1.26; }
.h2 { font-size: 36rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 0.4rpx; }
.h3 { font-size: 30rpx; font-weight: 600; color: #F4F7FC; }
.title { font-size: 32rpx; font-weight: 700; color: #FFFFFF; }
.sub { font-size: 26rpx; color: #9AA5B8; line-height: 1.66; }
.hint { font-size: 23rpx; color: #6E7A8E; line-height: 1.66; }
.tiny { font-size: 21rpx; color: #626D80; }
.gold { color: #F3C969; }
.white { color: #FFFFFF; }
.muted { color: #9AA5B8; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; letter-spacing: 0.5rpx; }
.strong { font-weight: 650; color: #FFFFFF; }
.num { font-family: "DIN Alternate", "SF Pro Display", -apple-system, sans-serif; font-weight: 700; font-variant-numeric: tabular-nums; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.eyebrow {
  display: inline-flex; align-items: center;
  font-size: 20rpx; letter-spacing: 4rpx; text-transform: uppercase;
  color: #D8B569;
}
.eyebrow::before {
  content: ""; width: 28rpx; height: 1rpx; margin-right: 14rpx;
  background: linear-gradient(90deg, transparent, #D8B569);
}

/* —— 卡片：玻璃 + 顶部高光 —— */
.card {
  position: relative;
  background: linear-gradient(158deg, rgba(255, 255, 255, 0.062), rgba(255, 255, 255, 0.018) 46%, rgba(255, 255, 255, 0.008));
  border: 1rpx solid rgba(255, 255, 255, 0.085);
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.32);
  overflow: hidden;
}
.card::before {
  content: "";
  position: absolute; left: 24rpx; right: 24rpx; top: 0; height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  opacity: 0.5;
}
.card-soft { background: rgba(255, 255, 255, 0.028); border-color: rgba(255, 255, 255, 0.06); box-shadow: none; }
.card-flat { background: rgba(255, 255, 255, 0.03); border: 1rpx solid rgba(255, 255, 255, 0.06); border-radius: 22rpx; padding: 22rpx; box-sizing: border-box; }
.card-gold {
  background:
    radial-gradient(120% 100% at 100% 0%, rgba(243, 201, 105, 0.18), rgba(243, 201, 105, 0) 58%),
    linear-gradient(160deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  border-color: rgba(243, 201, 105, 0.32);
}
.card-plain { background: #0C0F18; border-color: rgba(255, 255, 255, 0.07); }

/* —— 点击反馈（配合 hover-class="tap-on"）—— */
.tap { transition: transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.16s ease; }
.tap-on { transform: scale(0.972); opacity: 0.82; }
.press { opacity: 0.72; }

/* —— 按钮 —— */
.btn {
  position: relative;
  height: 94rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx;
  background: linear-gradient(118deg, #FFE2A6 0%, #F3C969 42%, #E29B3F 100%);
  color: #241705;
  box-shadow: 0 18rpx 40rpx rgba(226, 155, 63, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
  transition: transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease;
}
.btn::after {
  content: "";
  position: absolute; top: 0; bottom: 0; left: -60%; width: 45%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  transform: skewX(-18deg);
  animation: sweep 3.6s ease-in-out infinite;
}
@keyframes sweep {
  0%, 62% { left: -60%; }
  100% { left: 130%; }
}
.btn:active { transform: scale(0.976); box-shadow: 0 8rpx 20rpx rgba(226, 155, 63, 0.22); }
.btn-block { width: 100%; }
.btn-sm { height: 64rpx; font-size: 24rpx; padding: 0 30rpx; letter-spacing: 0; box-shadow: none; }
.btn-sm::after { display: none; }
.btn-ghost {
  background: rgba(243, 201, 105, 0.06); color: #F3C969;
  border: 1rpx solid rgba(243, 201, 105, 0.42); box-shadow: none;
}
.btn-ghost::after { display: none; }
.btn-plain { background: rgba(255, 255, 255, 0.07); color: #E4E9F3; box-shadow: none; }
.btn-plain::after { display: none; }
.btn-disabled { background: #1E2330; color: #66718A; box-shadow: none; }
.btn-disabled::after { display: none; }
.btn-danger { background: rgba(255, 112, 128, 0.1); color: #FF8B96; border: 1rpx solid rgba(255, 112, 128, 0.3); box-shadow: none; }
.btn-danger::after { display: none; }
button.btn { width: auto; margin: 0; line-height: normal; }
button.btn::after { border: none; }
button.btn-sm { padding: 0 26rpx; }
button { font-family: inherit; }

/* —— 表单 —— */
.field { margin-bottom: 30rpx; }
.field-label { font-size: 25rpx; color: #A9B3C5; margin-bottom: 14rpx; display: flex; align-items: center; justify-content: space-between; }
.field-label .opt { font-size: 21rpx; color: #626D80; }
.input, .textarea {
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  color: #F2F5FB; font-size: 28rpx; width: 100%; box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.textarea { height: 200rpx; line-height: 1.65; }
.input-focus { border-color: rgba(243, 201, 105, 0.62); background: rgba(243, 201, 105, 0.045); }
.input-ph { color: #4E586B; }
.counter { position: absolute; right: 22rpx; bottom: 16rpx; font-size: 20rpx; color: #566176; }
.counter.warn { color: #F3C969; }

/* —— 胶囊 / chips —— */
.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 15rpx 26rpx; margin: 0 14rpx 14rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04); border: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 24rpx; color: #9AA5B8;
  display: flex; align-items: center;
  transition: all 0.18s ease;
}
.chip.on {
  background: linear-gradient(140deg, rgba(243, 201, 105, 0.22), rgba(243, 201, 105, 0.06));
  border-color: rgba(243, 201, 105, 0.66);
  color: #FFE0A3; font-weight: 600;
  box-shadow: 0 8rpx 22rpx rgba(243, 201, 105, 0.16);
}
.chip-sm { padding: 9rpx 20rpx; font-size: 22rpx; margin: 0 12rpx 12rpx 0; border-radius: 12rpx; }
.chip-scroll { white-space: nowrap; }
.chip-scroll .chip { display: inline-flex; margin-bottom: 0; }

.pill {
  display: inline-flex; align-items: center;
  padding: 5rpx 16rpx; border-radius: 999rpx;
  font-size: 20rpx; font-weight: 500; line-height: 1.7;
  border: 1rpx solid transparent;
}
.pill::before { content: ""; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; margin-right: 8rpx; opacity: 0.9; }
.pill-gold { background: rgba(243, 201, 105, 0.12); color: #F3C969; border-color: rgba(243, 201, 105, 0.22); }
.pill-green { background: rgba(67, 216, 155, 0.12); color: #4BDFA4; border-color: rgba(67, 216, 155, 0.22); }
.pill-red { background: rgba(255, 112, 128, 0.12); color: #FF8B96; border-color: rgba(255, 112, 128, 0.22); }
.pill-blue { background: rgba(96, 165, 255, 0.12); color: #8CBEFF; border-color: rgba(96, 165, 255, 0.22); }
.pill-gray { background: rgba(255, 255, 255, 0.06); color: #93A0B4; border-color: rgba(255, 255, 255, 0.08); }
.pill-violet { background: rgba(142, 123, 255, 0.13); color: #B0A2FF; border-color: rgba(142, 123, 255, 0.24); }
.pill-no-dot::before { display: none; }

/* —— 顶部导航（自定义）—— */
.nav {
  position: sticky; top: 0; z-index: 60;
  padding: 0 32rpx; box-sizing: border-box;
  transition: background 0.25s ease, border-color 0.25s ease, backdrop-filter 0.25s ease;
  border-bottom: 1rpx solid transparent;
}
.nav-solid {
  background: rgba(6, 7, 12, 0.72);
  backdrop-filter: blur(24rpx);
  border-bottom-color: rgba(255, 255, 255, 0.06);
}
.nav-inner { height: 96rpx; display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; }
.brand-mark {
  position: relative;
  width: 66rpx; height: 66rpx; border-radius: 20rpx; margin-right: 16rpx;
  background: linear-gradient(145deg, #FFE2A6, #E29B3F);
  color: #221604; font-size: 34rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(226, 155, 63, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  overflow: hidden;
}
.brand-mark::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.55) 48%, transparent 66%);
  transform: translateX(-120%);
  animation: markShine 5s ease-in-out infinite;
}
@keyframes markShine { 0%, 55% { transform: translateX(-120%); } 85%, 100% { transform: translateX(120%); } }
.brand-name { font-size: 32rpx; font-weight: 750; color: #FFFFFF; letter-spacing: 3rpx; line-height: 1.2; }
.brand-sub { font-size: 19rpx; color: #78839A; letter-spacing: 3rpx; margin-top: 2rpx; }
.nav-right { display: flex; align-items: center; }

/* —— Hero —— */
.hero { position: relative; padding: 8rpx 40rpx 44rpx; overflow: hidden; }
.hero-kicker {
  display: inline-flex; align-items: center;
  font-size: 20rpx; letter-spacing: 4rpx; color: #E0BD77;
  border: 1rpx solid rgba(243, 201, 105, 0.3); border-radius: 999rpx;
  padding: 7rpx 20rpx; margin-bottom: 24rpx;
  background: rgba(243, 201, 105, 0.06);
}
.hero-title { font-size: 58rpx; font-weight: 800; line-height: 1.22; letter-spacing: -0.5rpx; color: #FFFFFF; }
.hero-title .accent,
.accent-text {
  background: linear-gradient(112deg, #FFE7B4 0%, #F3C969 46%, #DE9A3E 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.hero-desc { font-size: 25rpx; color: #99A4B8; margin-top: 16rpx; line-height: 1.62; }
.hero-chips { display: flex; align-items: center; flex-wrap: wrap; margin-top: 26rpx; }
.balance-pill {
  display: inline-flex; align-items: center;
  padding: 11rpx 22rpx; border-radius: 999rpx; margin-right: 16rpx;
  background: rgba(243, 201, 105, 0.1);
  border: 1rpx solid rgba(243, 201, 105, 0.3);
  color: #F3C969; font-size: 23rpx; font-weight: 600;
}
.hero-stat { font-size: 22rpx; color: #7C879C; margin-right: 22rpx; }
.hero-stat .gold { font-weight: 700; }

/* —— 区块标题 —— */
.section { margin: 40rpx 4rpx 20rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.section-title { position: relative; font-size: 32rpx; font-weight: 700; color: #FFFFFF; padding-left: 20rpx; }
.section-title::before {
  content: ""; position: absolute; left: 0; top: 8rpx; bottom: 8rpx; width: 6rpx; border-radius: 999rpx;
  background: linear-gradient(180deg, #F3C969, rgba(243, 201, 105, 0.15));
}
.section-sub { font-size: 22rpx; color: #626D80; margin-left: 12rpx; }
.section-more { font-size: 23rpx; color: #F3C969; }
.rule { height: 1rpx; background: linear-gradient(90deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0)); margin: 24rpx 0; }
.hairline { height: 1rpx; background: rgba(255, 255, 255, 0.07); margin: 22rpx 0; }

/* —— 封面 / 缩略图 —— */
.cover {
  position: relative; overflow: hidden; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.cover::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.16), transparent 45%, rgba(0, 0, 0, 0.3));
  pointer-events: none;
}
.cover-char {
  font-size: 88rpx; font-weight: 800; color: rgba(255, 255, 255, 0.94);
  text-shadow: 0 8rpx 26rpx rgba(0, 0, 0, 0.4);
  letter-spacing: 2rpx;
}
.cover-a { background: linear-gradient(145deg, #40305E, #76519E 55%, #2A1F3D); }
.cover-b { background: linear-gradient(145deg, #103C4C, #1F8491 55%, #0C2A34); }
.cover-c { background: linear-gradient(145deg, #4E2B1B, #B06D3B 55%, #341D13); }
.cover-d { background: linear-gradient(145deg, #2A3350, #4F6AA3 55%, #1A2136); }
.cover-e { background: linear-gradient(145deg, #4E1F2E, #A6475D 55%, #33131C); }
.cover-f { background: linear-gradient(145deg, #25331D, #628144 55%, #172111); }
.ai-badge {
  position: absolute; left: 12rpx; bottom: 12rpx; z-index: 2;
  padding: 3rpx 10rpx; border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.5); color: rgba(255, 255, 255, 0.78);
  font-size: 17rpx; letter-spacing: 1rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

/* —— 进度 —— */
.progress { height: 8rpx; background: rgba(255, 255, 255, 0.08); border-radius: 999rpx; overflow: hidden; }
.progress-bar {
  position: relative; height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #F7D98F, #F3C969 45%, #E29B3F);
  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}
.progress-bar::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  animation: barShine 2.4s ease-in-out infinite;
}
@keyframes barShine { 0% { transform: translateX(-100%); } 60%, 100% { transform: translateX(100%); } }

/* 进度环：外圈 conic-gradient，由 JS 生成 style */
.ring {
  position: relative; width: 132rpx; height: 132rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.8s ease;
}
.ring::after {
  content: ""; position: absolute; inset: 9rpx; border-radius: 50%;
  background: #0A0C13;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.06);
}
.ring-inner { position: relative; z-index: 2; text-align: center; }
.ring-value { font-size: 34rpx; font-weight: 800; color: #FFFFFF; line-height: 1.1; }
.ring-label { font-size: 17rpx; color: #6E7A8E; letter-spacing: 1rpx; }

/* —— 数据 —— */
.stat { flex: 1; text-align: center; }
.stat-value { font-size: 42rpx; font-weight: 800; color: #FFFFFF; letter-spacing: 0.5rpx; line-height: 1.15; }
.stat-value small { font-size: 21rpx; font-weight: 500; color: #8D97A9; margin-left: 4rpx; }
.stat-label { font-size: 21rpx; color: #6E7A8E; margin-top: 6rpx; letter-spacing: 1rpx; }
.stat-divider { width: 1rpx; height: 54rpx; background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.14), transparent); }
.stat-tile {
  flex: 1; padding: 22rpx 10rpx; border-radius: 20rpx; text-align: center;
  background: rgba(255, 255, 255, 0.035); border: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* —— 列表 —— */
.list-item { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.06); }
.list-item:last-child { border-bottom: none; }
.list-avatar {
  width: 78rpx; height: 78rpx; border-radius: 22rpx; margin-right: 22rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
}
.list-main { flex: 1; min-width: 0; }
.list-title { font-size: 28rpx; color: #EDF1F8; font-weight: 550; }
.list-sub { font-size: 22rpx; color: #6E7A8E; margin-top: 6rpx; }
.list-right { font-size: 24rpx; color: #9AA5B8; margin-left: 16rpx; text-align: right; }
.divider { height: 1rpx; background: rgba(255, 255, 255, 0.06); margin: 8rpx 0; }

/* —— 空态 / 错误 / 骨架 —— */
.empty { padding: 72rpx 30rpx; text-align: center; }
.empty-icon {
  width: 112rpx; height: 112rpx; border-radius: 34rpx; margin: 0 auto 24rpx;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; color: #6E7A8E;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.3);
}
.empty-title { font-size: 28rpx; color: #C6CFDD; font-weight: 600; }
.empty-sub { font-size: 23rpx; color: #6E7A8E; margin-top: 10rpx; line-height: 1.66; }
.error-box { padding: 26rpx; border-radius: 20rpx; background: rgba(255, 112, 128, 0.07); border: 1rpx solid rgba(255, 112, 128, 0.22); }
.error-text { font-size: 24rpx; color: #FF9AA3; line-height: 1.6; }
.skeleton { background: linear-gradient(90deg, #121721 25%, #1B2231 37%, #121721 63%); background-size: 400% 100%; animation: sk 1.4s ease infinite; border-radius: 14rpx; }
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
.sk-line { height: 24rpx; margin-bottom: 16rpx; }
.sk-block { height: 190rpx; margin-bottom: 20rpx; border-radius: 26rpx; }

/* —— 分段 tab + 滑动指示器 —— */
.seg {
  position: relative; display: flex; padding: 7rpx;
  background: rgba(255, 255, 255, 0.04); border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 20rpx; margin-bottom: 24rpx; overflow: hidden;
}
.seg-item {
  position: relative; z-index: 2; flex: 1; text-align: center;
  padding: 15rpx 2rpx; font-size: 24rpx; color: #8D97A9;
  transition: color 0.24s ease, font-weight 0.2s;
}
.seg-item.on { color: #1A1206; font-weight: 700; }
.seg-ind {
  position: absolute; z-index: 1; top: 7rpx; bottom: 7rpx; left: 7rpx;
  border-radius: 15rpx;
  background: linear-gradient(120deg, #FFE2A6, #F3C969 55%, #E8AE55);
  box-shadow: 0 8rpx 20rpx rgba(226, 155, 63, 0.28);
  transition: transform 0.34s cubic-bezier(0.2, 0.9, 0.25, 1);
}
.tabs { display: flex; background: rgba(255, 255, 255, 0.04); border: 1rpx solid rgba(255, 255, 255, 0.07); border-radius: 20rpx; padding: 7rpx; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 15rpx 4rpx; font-size: 24rpx; color: #8D97A9; border-radius: 14rpx; }
.tab-on { background: rgba(255, 255, 255, 0.1); color: #FFFFFF; font-weight: 600; }
.tab-scroll { white-space: nowrap; }
.tab-scroll .tab { display: inline-block; padding: 14rpx 24rpx; }

/* —— 流程节点 —— */
.node { display: flex; }
.node-rail { width: 46rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.node-dot {
  width: 22rpx; height: 22rpx; border-radius: 50%;
  background: #2A3242; border: 3rpx solid #0A0C13; margin-top: 12rpx;
  transition: all 0.3s ease;
}
.node-dot.done { background: #43D89B; box-shadow: 0 0 0 4rpx rgba(67, 216, 155, 0.14), 0 0 18rpx rgba(67, 216, 155, 0.5); }
.node-dot.running { background: #F3C969; animation: dotPulse 1.6s ease-in-out infinite; }
.node-dot.failed { background: #FF7080; }
.node-dot.skipped { background: #5F6A7D; }
@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(243, 201, 105, 0.4); }
  50% { box-shadow: 0 0 0 8rpx rgba(243, 201, 105, 0.02), 0 0 22rpx rgba(243, 201, 105, 0.5); }
}
.node-line { flex: 1; width: 2rpx; background: linear-gradient(180deg, rgba(243, 201, 105, 0.35), rgba(255, 255, 255, 0.07)); margin: 8rpx 0; }
.node-body { flex: 1; padding: 0 0 32rpx 10rpx; min-width: 0; }
.node-head { display: flex; align-items: center; justify-content: space-between; }
.node-name { font-size: 26rpx; color: #E2E8F2; font-weight: 550; }
.node-meta { font-size: 21rpx; color: #6E7A8E; margin-top: 5rpx; }

/* —— 底部弹层 —— */
.sheet-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, 0.66);
  z-index: 900; display: flex; align-items: flex-end;
  animation: maskIn 0.22s ease both;
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }
.sheet {
  width: 100%; background: linear-gradient(180deg, #141926, #0D1018);
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 84vh; box-sizing: border-box;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  animation: sheetUp 0.34s cubic-bezier(0.16, 1.02, 0.3, 1) both;
}
@keyframes sheetUp { from { transform: translateY(120rpx); opacity: 0.4; } to { transform: translateY(0); opacity: 1; } }
.sheet-bar { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.2); margin: 10rpx auto 24rpx; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; color: #FFFFFF; }
.sheet-close { font-size: 26rpx; color: #7C8699; padding: 6rpx 10rpx; }
.sheet-scroll { max-height: 62vh; }

/* —— 价格 / 套餐 —— */
.pkg {
  flex: 1; border: 1rpx solid rgba(255, 255, 255, 0.08); border-radius: 24rpx;
  padding: 26rpx 16rpx; text-align: center;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
  position: relative; transition: all 0.2s ease;
}
.pkg.on {
  border-color: rgba(243, 201, 105, 0.7);
  background: linear-gradient(160deg, rgba(243, 201, 105, 0.16), rgba(243, 201, 105, 0.03));
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 36rpx rgba(243, 201, 105, 0.16);
}
.pkg-points { font-size: 40rpx; font-weight: 800; color: #FFFFFF; }
.pkg-points small { font-size: 20rpx; color: #8D97A9; margin-left: 4rpx; font-weight: 400; }
.pkg-price { font-size: 24rpx; color: #F3C969; margin-top: 8rpx; }
.pkg-tag {
  position: absolute; top: -14rpx; right: 14rpx;
  background: linear-gradient(120deg, #FFE2A6, #F3C969); color: #241705; font-size: 18rpx;
  padding: 3rpx 12rpx; border-radius: 8rpx; font-weight: 700;
}

/* —— 提示条 —— */
.notice {
  display: flex; align-items: flex-start;
  padding: 20rpx 22rpx; border-radius: 18rpx;
  background: rgba(243, 201, 105, 0.06);
  border: 1rpx solid rgba(243, 201, 105, 0.18);
  font-size: 22rpx; color: #CBB37A; line-height: 1.62;
}
.notice-dark { background: rgba(255, 255, 255, 0.03); border-color: rgba(255, 255, 255, 0.07); color: #7C8699; }
.dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #F3C969; margin-right: 12rpx; flex-shrink: 0; margin-top: 13rpx; box-shadow: 0 0 10rpx rgba(243, 201, 105, 0.8); }
.link { color: #F3C969; }
.footer-note { text-align: center; font-size: 20rpx; color: #4F5969; line-height: 1.8; padding: 30rpx 20rpx 10rpx; }
.tag-ai { font-size: 18rpx; color: #B0A2FF; border: 1rpx solid rgba(142, 123, 255, 0.35); border-radius: 6rpx; padding: 2rpx 8rpx; }

/* —— 动效工具类 —— */
.rise { animation: rise 0.52s cubic-bezier(0.16, 0.84, 0.28, 1) both; }
@keyframes rise { from { opacity: 0; transform: translate3d(0, 26rpx, 0); } to { opacity: 1; transform: none; } }
.d1 { animation-delay: 0.04s; } .d2 { animation-delay: 0.08s; } .d3 { animation-delay: 0.12s; }
.d4 { animation-delay: 0.16s; } .d5 { animation-delay: 0.2s; } .d6 { animation-delay: 0.24s; }
.d7 { animation-delay: 0.28s; } .d8 { animation-delay: 0.32s; } .d9 { animation-delay: 0.36s; } .d10 { animation-delay: 0.4s; }
.float { animation: floatY 4.4s ease-in-out infinite; }
@keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
.breathe { animation: breathe 3.4s ease-in-out infinite; }
@keyframes breathe { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
.spin { animation: spin 1.1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ============================================================
   设计系统 v3 · 数据与账号（V4.4 增量）
   —— 只加不改：v2 的类一律保留，新页面用下面这套
   ============================================================ */

/* —— 玻璃面板：比纯色卡更有层次，仍保持深色不发灰 —— */
.glass {
  position: relative;
  border-radius: 28rpx;
  background: linear-gradient(158deg, rgba(255, 255, 255, 0.065), rgba(255, 255, 255, 0.018));
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  box-shadow: 0 18rpx 46rpx -24rpx rgba(0, 0, 0, 0.9), inset 0 1rpx 0 rgba(255, 255, 255, 0.07);
  overflow: hidden;
}
.glass::after {
  content: "";
  position: absolute; inset: 0;
  background: radial-gradient(120% 80% at 100% 0%, rgba(243, 201, 105, 0.1), rgba(243, 201, 105, 0) 60%);
  pointer-events: none;
}

/* —— 统计卡：一个数字 + 一句解释 —— */
.stat-row { display: flex; gap: 16rpx; }
.stat {
  flex: 1; min-width: 0;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.stat-num {
  font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx;
  color: #F7E4B4; font-variant-numeric: tabular-nums;
}
.stat-num.small { font-size: 30rpx; }
.stat-label { margin-top: 6rpx; font-size: 20rpx; color: #8B95A6; }

/* —— 分段控件 —— */
.seg {
  display: flex; padding: 6rpx; border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.36);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.seg-item {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 24rpx; color: #909AAA; border-radius: 999rpx;
  transition: color .2s ease, background .24s ease, transform .24s ease;
}
.seg-item.on {
  color: #21170A; font-weight: 600;
  background: linear-gradient(135deg, #F7D793, #E8B95D);
  box-shadow: 0 8rpx 20rpx -10rpx rgba(243, 201, 105, 0.8);
}

/* —— 柱状图（纯 CSS，不引图表库） —— */
.bars { display: flex; align-items: flex-end; gap: 14rpx; height: 180rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar-fill {
  width: 100%; border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, rgba(247, 215, 147, 0.95), rgba(232, 185, 93, 0.35));
  animation: barRise .62s cubic-bezier(.2,.9,.2,1) both;
  transform-origin: bottom center;
}
.bar-fill.alt { background: linear-gradient(180deg, rgba(126, 102, 255, 0.9), rgba(126, 102, 255, 0.3)); }
.bar-label { margin-top: 10rpx; font-size: 19rpx; color: #7C8697; }
@keyframes barRise { from { transform: scaleY(0.02); opacity: .2; } to { transform: scaleY(1); opacity: 1; } }

/* —— 列表行（资产/账变/平台通用） —— */
.lrow {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}
.lrow:last-child { border-bottom: none; }
.lrow-main { flex: 1; min-width: 0; }
.lrow-title { font-size: 26rpx; color: #E9EEF7; }
.lrow-sub { margin-top: 6rpx; font-size: 20rpx; color: #7E8899; }
.lrow-right { text-align: right; flex: none; }
.lrow-amount { font-size: 27rpx; font-weight: 600; color: #F7E4B4; font-variant-numeric: tabular-nums; }
.lrow-amount.plus { color: #7BE0A8; }
.lrow-amount.minus { color: #FF8E8E; }

/* —— 底部弹层 —— */
.sheet-mask {
  position: fixed; inset: 0; z-index: 90;
  background: rgba(2, 4, 8, 0.62);
  backdrop-filter: blur(6rpx);
  animation: fadeIn .2s ease both;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 91;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #0E121A;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  animation: sheetUp .32s cubic-bezier(.2,.9,.2,1) both;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheetUp { from { transform: translate3d(0, 100%, 0); } to { transform: translate3d(0, 0, 0); } }

/* —— 骨架屏 —— */
.skeleton {
  border-radius: 16rpx;
  background: linear-gradient(100deg, rgba(255,255,255,.05) 30%, rgba(255,255,255,.11) 50%, rgba(255,255,255,.05) 70%);
  background-size: 220% 100%;
  animation: shimmer 1.3s linear infinite;
}
@keyframes shimmer { from { background-position: 140% 0; } to { background-position: -40% 0; } }

/* —— 进度环（额度/完成度用） —— */
.ring { position: relative; width: 128rpx; height: 128rpx; }
.ring-track, .ring-val { position: absolute; inset: 0; border-radius: 50%; }
.ring-track { background: conic-gradient(rgba(255,255,255,.09) 0 100%); }
.ring-val { background: conic-gradient(#F3C969 var(--deg, 0deg), rgba(0,0,0,0) 0); transition: --deg .6s ease; }
.ring-inner {
  position: absolute; inset: 14rpx; border-radius: 50%;
  background: #0B0E14; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #F7E4B4; font-weight: 700;
}

/* —— 输入行（登录/设置复用） —— */
.field {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 22rpx; margin-top: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  transition: border-color .2s ease, background .2s ease;
}
.field.focus { border-color: rgba(243, 201, 105, 0.55); background: rgba(243, 201, 105, 0.06); }
.field-input { flex: 1; min-width: 0; font-size: 27rpx; color: #EDF1F8; }
.field-ph { color: #5C6675; font-size: 26rpx; }
.field-btn {
  flex: none; padding: 10rpx 22rpx; border-radius: 999rpx;
  font-size: 22rpx; color: #F3C969;
  background: rgba(243, 201, 105, 0.12);
  border: 1rpx solid rgba(243, 201, 105, 0.3);
}
.field-btn.off { color: #6B7484; background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.08); }

/* —— 标签 —— */
.tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 19rpx; color: #C8D2E0;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.tag.gold { color: #F7D793; background: rgba(243, 201, 105, 0.12); border-color: rgba(243, 201, 105, 0.26); }
.tag.violet { color: #C3B6FF; background: rgba(126, 102, 255, 0.14); border-color: rgba(126, 102, 255, 0.28); }
