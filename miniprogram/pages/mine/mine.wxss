/* ============================================================
   我的 · 夜戏设计系统 v2
   ============================================================ */

.screen { padding-bottom: 40rpx; }
.layer { padding: 24rpx 28rpx 0; box-sizing: border-box; }

/* —— 用户头部 —— */
.me-head {
  display: flex; align-items: center;
  padding: 8rpx 4rpx 34rpx;
  animation: rise 0.5s cubic-bezier(0.16, 0.84, 0.28, 1) both;
}
.me-avatar {
  position: relative;
  width: 116rpx; height: 116rpx; border-radius: 36rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(150deg, #FFE2A6, #E29B3F 62%, #B97325);
  box-shadow: 0 18rpx 42rpx rgba(226, 155, 63, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
}
.me-avatar::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(148deg, rgba(255, 255, 255, 0.34), transparent 46%);
  pointer-events: none;
}
.me-avatar-img { width: 100%; height: 100%; }
.me-avatar-char { font-size: 50rpx; font-weight: 800; color: #2A1B05; letter-spacing: 2rpx; }
.me-name { font-size: 38rpx; font-weight: 750; color: #FFFFFF; letter-spacing: 0.4rpx; }
.me-id {
  font-size: 21rpx; color: #6E7A8E; margin-top: 8rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace; letter-spacing: 0.6rpx;
}
.me-edit {
  flex-shrink: 0; font-size: 23rpx; color: #B7C1D1;
  padding: 10rpx 22rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

/* —— 余额卡 —— */
.balance-card {
  position: relative; overflow: hidden;
  padding: 32rpx 30rpx 28rpx; border-radius: 32rpx;
  background:
    radial-gradient(120% 100% at 100% 0%, rgba(255, 255, 255, 0.5), transparent 58%),
    linear-gradient(140deg, #FFEFC9 0%, #F6D491 42%, #E7B45F 100%);
  box-shadow: 0 24rpx 60rpx rgba(226, 155, 63, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.72);
  animation: rise 0.54s cubic-bezier(0.16, 0.84, 0.28, 1) 0.05s both;
}
.balance-card::before {
  content: ""; position: absolute; top: -60rpx; right: -50rpx;
  width: 260rpx; height: 260rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55), transparent 68%);
  animation: breathe 5s ease-in-out infinite;
}
.balance-card::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(115deg, transparent 34%, rgba(255, 255, 255, 0.42) 48%, transparent 62%);
  transform: translateX(-130%);
  animation: balSweep 6.5s ease-in-out infinite;
  pointer-events: none;
}
@keyframes balSweep { 0%, 58% { transform: translateX(-130%); } 92%, 100% { transform: translateX(130%); } }
.balance-num { display: flex; align-items: baseline; margin-top: 20rpx; position: relative; z-index: 2; }
.balance-num .num { font-size: 86rpx; font-weight: 800; color: #2A1B05; letter-spacing: -1rpx; line-height: 1; }
.balance-unit { font-size: 26rpx; color: #7B5F2B; font-weight: 600; margin-left: 10rpx; }
.balance-card .tiny { position: relative; z-index: 2; margin-top: 12rpx; }
.balance-actions { display: flex; margin-top: 28rpx; position: relative; z-index: 2; }
.b-action {
  flex: 1; text-align: center; height: 72rpx; line-height: 72rpx;
  border-radius: 20rpx; font-size: 25rpx; font-weight: 600;
  color: #4A360F;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  margin-right: 16rpx;
  transition: transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.2s ease;
}
.b-action:last-child { margin-right: 0; }
.b-action.primary {
  background: linear-gradient(140deg, #3B2A0B, #221604);
  color: #FFE1A5; border-color: rgba(0, 0, 0, 0.2);
  box-shadow: 0 10rpx 24rpx rgba(42, 27, 5, 0.32);
}

/* —— 档位横滑 —— */
.pkg-scroll { white-space: nowrap; margin: 0; padding: 4rpx 0 12rpx; }
.pkg-card {
  position: relative; display: inline-block; vertical-align: top;
  width: 206rpx; margin-right: 18rpx; padding: 26rpx 20rpx 22rpx;
  border-radius: 26rpx; text-align: left; box-sizing: border-box;
  background: linear-gradient(158deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.014));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.2s, box-shadow 0.24s;
  white-space: normal;
}
.pkg-card:last-child { margin-right: 0; }
.pkg-card.on {
  border-color: rgba(243, 201, 105, 0.66);
  background: linear-gradient(158deg, rgba(243, 201, 105, 0.2), rgba(243, 201, 105, 0.04));
  box-shadow: 0 18rpx 40rpx rgba(243, 201, 105, 0.18);
  transform: translateY(-4rpx);
}
.pkg-card .pkg-tag {
  position: absolute; top: -12rpx; right: 14rpx;
  font-size: 17rpx; padding: 3rpx 10rpx;
}
.pkg-points { font-size: 38rpx; color: #FFFFFF; line-height: 1.1; }
.pkg-unit { font-size: 19rpx; color: #8D97A9; font-weight: 400; margin-left: 4rpx; }
.pkg-price { font-size: 25rpx; color: #F3C969; margin-top: 10rpx; font-weight: 600; }
.pkg-note { font-size: 19rpx; color: #6E7A8E; margin-top: 8rpx; }
.pkg-empty {
  display: inline-block; padding: 40rpx 24rpx; font-size: 23rpx; color: #626D80;
}

/* —— 快捷入口 —— */
.tool-grid { display: flex; margin-top: 26rpx; }
.tool {
  flex: 1; margin-right: 16rpx; padding: 26rpx 18rpx 22rpx;
  border-radius: 24rpx; text-align: center;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  animation: rise 0.5s cubic-bezier(0.16, 0.84, 0.28, 1) both;
}
.tool:nth-child(1) { animation-delay: 0.06s; }
.tool:nth-child(2) { animation-delay: 0.11s; }
.tool:nth-child(3) { animation-delay: 0.16s; margin-right: 0; }
.tool-icon {
  width: 62rpx; height: 62rpx; line-height: 62rpx; margin: 0 auto 14rpx;
  border-radius: 20rpx; font-size: 30rpx; color: #F3C969;
  background: rgba(243, 201, 105, 0.1);
  border: 1rpx solid rgba(243, 201, 105, 0.2);
}
.tool-name { font-size: 24rpx; color: #E6ECF6; font-weight: 600; }
.tool-sub { font-size: 18rpx; color: #626D80; margin-top: 6rpx; }

/* —— 账单 —— */
.bill {
  display: flex; align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}
.bill:first-child { padding-top: 4rpx; }
.bill:last-child { border-bottom: none; padding-bottom: 4rpx; }
.bill-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0;
  margin-right: 20rpx;
}
.bill-dot.in { background: #4BDFA4; box-shadow: 0 0 14rpx rgba(75, 223, 164, 0.6); }
.bill-dot.out { background: #7C8699; box-shadow: none; }
.bill-title { font-size: 26rpx; color: #E2E8F2; }
.bill-sub { font-size: 20rpx; color: #626D80; margin-top: 6rpx; }
.bill-points { font-size: 30rpx; font-weight: 700; margin-left: 16rpx; }
.bill-points.in { color: #4BDFA4; }
.bill-points.out { color: #9AA5B8; }

/* —— 协议行 —— */
.legal-row {
  display: flex; align-items: center; justify-content: center;
  margin-top: 36rpx; font-size: 22rpx;
}
.legal-sep { color: #3B4453; margin: 0 16rpx; }

/* —— 充值弹层内的档位行 —— */
.pkg-row {
  display: flex; align-items: center;
  padding: 24rpx 24rpx; border-radius: 22rpx; margin-bottom: 14rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  transition: border-color 0.2s, background 0.2s;
}
.pkg-row.on {
  border-color: rgba(243, 201, 105, 0.66);
  background: rgba(243, 201, 105, 0.12);
}
.pkg-row-points { font-size: 28rpx; color: #FFFFFF; font-weight: 600; }
.pkg-bonus {
  font-size: 19rpx; color: #241705; font-weight: 700;
  background: linear-gradient(120deg, #FFE2A6, #F3C969);
  padding: 2rpx 10rpx; border-radius: 7rpx; margin-left: 12rpx;
}
.pkg-row-price { font-size: 30rpx; color: #F3C969; font-weight: 700; margin-left: 16rpx; }
.pay-note {
  font-size: 20rpx; color: #566176; text-align: center;
  line-height: 1.66; margin-top: 22rpx;
}

/* —— 兑换 —— */
.redeem-input { letter-spacing: 2rpx; font-family: "SF Mono", Menlo, Consolas, monospace; }
.redeem-history { margin-top: 26rpx; }
.redeem-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; font-size: 23rpx; color: #9AA5B8;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.redeem-item:last-child { border-bottom: none; }

/* —— 关于 —— */
.about-brand { text-align: center; display: flex; flex-direction: column; align-items: center; }
.about-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0; margin-top: 6rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.about-row .tiny { max-width: 60%; text-align: right; line-height: 1.5; }

/* 兑换输入：给 input 一个呼吸位 */
.input-wrap { margin-top: 6rpx; }

/* —— 资料完善提示 —— */
.me-tip {
  margin-top: 6rpx;
  font-size: 20rpx; color: #E0BD77;
  text-decoration: underline;
}

/* —— 充值活动条 —— */
.campaign {
  display: flex; align-items: center;
  margin-top: 8rpx; padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(243, 201, 105, 0.09);
  border: 1rpx solid rgba(243, 201, 105, 0.26);
}
.campaign-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  margin-right: 16rpx; flex: none;
  background: #F3C969;
  box-shadow: 0 0 12rpx rgba(243, 201, 105, 0.8);
}
.campaign-title { font-size: 24rpx; font-weight: 600; color: #FFE0A3; }
.campaign-sub { font-size: 20rpx; color: #A99260; margin-top: 4rpx; line-height: 1.5; }

/* —— 我的资产 —— */
.film-row {
  display: flex; align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}
.film-row:last-child { border-bottom: none; }
.film-main { flex: 1; min-width: 0; }
.film-title { font-size: 25rpx; color: #E7ECF5; }
.film-idx {
  font-size: 20rpx; color: #FFE0A3; margin-right: 10rpx;
  font-family: "SF Mono", Menlo, monospace;
}
.film-sub { font-size: 20rpx; color: #7D8899; margin-top: 6rpx; }
.film-copy {
  flex: none; margin-left: 16rpx;
  padding: 8rpx 20rpx; border-radius: 999rpx;
  font-size: 21rpx; color: #C6CFDD;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* —— V4.4 账号安全 / 收益入口 —— */
.login-bar {
  display: flex; align-items: center; gap: 12rpx;
  margin: 4rpx 0 18rpx; padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 138, 138, 0.07);
  border: 1rpx solid rgba(255, 138, 138, 0.22);
}
.login-bar-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #FF8E8E; box-shadow: 0 0 10rpx rgba(255, 142, 142, .8);
}
.login-bar-text { font-size: 21rpx; color: #E8A9A9; }

.rev-card {
  display: flex; align-items: center;
  margin-top: 18rpx; padding: 24rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, rgba(126, 102, 255, 0.14), rgba(255, 255, 255, 0.03));
  border: 1rpx solid rgba(126, 102, 255, 0.26);
}
.rev-left { flex: 1; min-width: 0; }
.rev-label { font-size: 27rpx; font-weight: 600; color: #E6E1FF; }
.rev-sub { margin-top: 6rpx; font-size: 20rpx; color: #9C95C6; }
.rev-right { text-align: right; flex: none; }
.rev-num { font-size: 34rpx; font-weight: 700; color: #F7E4B4; font-variant-numeric: tabular-nums; }
.rev-more { margin-top: 4rpx; font-size: 20rpx; color: #C3B6FF; }

.sec-state { display: flex; gap: 16rpx; margin-top: 6rpx; }
.sec-item {
  flex: 1; padding: 18rpx 18rpx; border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.sec-k { font-size: 20rpx; color: #8B95A6; }
.sec-v { margin-top: 6rpx; font-size: 26rpx; color: #E9EEF7; }
.sec-dev { margin-top: 12rpx; font-size: 20rpx; color: #A99260; }
.sec-err { margin-top: 16rpx; font-size: 22rpx; color: #FF8E8E; }
