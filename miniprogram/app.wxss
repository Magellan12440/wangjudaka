/* ============================================================
   网剧大咖 · 设计系统 v4「晴光」
   明亮轻快：冷白纸感底 + 暖橙主色 + 玻璃卡片
   —— 类名与 v2/v3 完全兼容，只换配色与观感，不改结构
   ============================================================ */

page {
  background: #F4F7FD;
  color: #16233A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* —— 画布 / 背景 —— */
.screen {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 注意：这里不能用 overflow-x: hidden —— 它会让 .screen 变成横向滚动容器，
     内部 position: sticky 的吸顶导航随即失效（sticky 相对不滚动的 scrollport）。
     clip 只裁剪、不建立滚动容器，sticky 才能正常工作。 */
  overflow-x: clip;
  background: linear-gradient(180deg, #ECF3FF 0%, #F7FAFF 30%, #FFFCF7 100%);
}
.page { min-height: 100vh; padding: 0 28rpx 60rpx; box-sizing: border-box; }
.page-flush { min-height: 100vh; padding-bottom: 60rpx; }
.screen-in { animation: pageIn 0.46s cubic-bezier(0.16, 0.84, 0.28, 1) both; }
@keyframes pageIn {
  from { opacity: 0; transform: translate3d(0, 22rpx, 0) scale(0.995); }
  to { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

/* 光晕：三团很淡的彩色光，白底上只做一点空气感，不压暗内容 */
.aurora { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
.aurora view { position: absolute; border-radius: 50%; filter: blur(60rpx); opacity: 0.5; }
.aurora-a {
  width: 620rpx; height: 620rpx; top: -240rpx; right: -180rpx;
  background: radial-gradient(circle at 30% 30%, rgba(255, 190, 120, 0.55), rgba(255, 190, 120, 0) 68%);
  animation: driftA 18s ease-in-out infinite alternate;
}
.aurora-b {
  width: 560rpx; height: 560rpx; top: 120rpx; left: -260rpx;
  background: radial-gradient(circle at 50% 50%, rgba(150, 175, 255, 0.5), rgba(150, 175, 255, 0) 70%);
  animation: driftB 22s ease-in-out infinite alternate;
}
.aurora-c {
  width: 480rpx; height: 480rpx; top: 520rpx; right: -160rpx;
  background: radial-gradient(circle at 50% 50%, rgba(120, 225, 218, 0.35), rgba(120, 225, 218, 0) 70%);
  animation: driftC 26s ease-in-out infinite alternate;
}
@keyframes driftA { from { transform: translate3d(0, 0, 0) scale(1); } to { transform: translate3d(-40rpx, 60rpx, 0) scale(1.12); } }
@keyframes driftB { from { transform: translate3d(0, 0, 0) scale(1.05); } to { transform: translate3d(50rpx, -70rpx, 0) scale(0.92); } }
@keyframes driftC { from { transform: translate3d(0, 0, 0) scale(0.95); } to { transform: translate3d(-30rpx, -50rpx, 0) scale(1.1); } }

.layer { position: relative; z-index: 1; }

/* —— 布局 —— */
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.center { display: flex; align-items: center; justify-content: center; }
.flex1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }
.gap8 { height: 8rpx; } .gap16 { height: 16rpx; } .gap24 { height: 24rpx; } .gap32 { height: 32rpx; }
.mt8 { margin-top: 8rpx; } .mt12 { margin-top: 12rpx; } .mt16 { margin-top: 16rpx; } .mt24 { margin-top: 24rpx; } .mt32 { margin-top: 32rpx; }
.mb6 { margin-bottom: 6rpx; } .mb8 { margin-bottom: 8rpx; } .mb12 { margin-bottom: 12rpx; } .mb16 { margin-bottom: 16rpx; } .mb24 { margin-bottom: 24rpx; }
.pad { padding: 0 32rpx; box-sizing: border-box; }
.safe-bottom { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }

/* —— 文字 —— */
.display { font-size: 64rpx; font-weight: 800; line-height: 1.2; letter-spacing: -0.5rpx; color: #16233A; }
.h1 { font-size: 46rpx; font-weight: 700; letter-spacing: 0; color: #16233A; line-height: 1.34; }
.h2 { font-size: 36rpx; font-weight: 700; color: #16233A; line-height: 1.4; }
.h3 { font-size: 30rpx; font-weight: 600; color: #22314A; line-height: 1.45; }
.title { font-size: 32rpx; font-weight: 700; color: #16233A; line-height: 1.4; }
.sub { font-size: 26rpx; color: #5A6779; line-height: 1.68; }
.hint { font-size: 23rpx; color: #8B95A5; line-height: 1.68; }
.tiny { font-size: 21rpx; color: #9AA5B5; line-height: 1.6; }
.gold { color: #E08A22; }
.white { color: #FFFFFF; }
.muted { color: #7C8798; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; letter-spacing: 0.2rpx; }
.strong { font-weight: 650; color: #16233A; }
.num { font-family: "DIN Alternate", "SF Pro Display", -apple-system, sans-serif; font-weight: 700; font-variant-numeric: tabular-nums; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.eyebrow {
  display: inline-flex; align-items: center;
  font-size: 20rpx; letter-spacing: 3rpx; text-transform: uppercase;
  color: #C67F25;
}
.eyebrow::before {
  content: ""; width: 24rpx; height: 2rpx; margin-right: 12rpx; border-radius: 2rpx;
  background: linear-gradient(90deg, rgba(224, 138, 34, 0), #E8A24A);
}

/* —— 卡片：白纸 + 柔和投影，靠留白而不是靠发光 —— */
.card {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 35, 58, 0.07);
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx -18rpx rgba(24, 50, 102, 0.28);
}
.card-soft { background: #F8FAFE; border-color: rgba(22, 35, 58, 0.06); box-shadow: none; }
.card-flat { background: #F8FAFE; border: 1rpx solid rgba(22, 35, 58, 0.07); border-radius: 22rpx; padding: 22rpx; box-sizing: border-box; }
.card-gold {
  background: linear-gradient(160deg, #FFF9EF 0%, #FFFFFF 62%);
  border-color: rgba(232, 162, 74, 0.34);
}
.card-plain { background: #FFFFFF; border-color: rgba(22, 35, 58, 0.07); }

/* —— 点击反馈（配合 hover-class="tap-on"）—— */
.tap { transition: transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.16s ease; }
.tap-on { transform: scale(0.974); opacity: 0.9; }
.press { opacity: 0.78; }

/* —— 按钮 —— */
.btn {
  position: relative;
  height: 92rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700; letter-spacing: 0.5rpx;
  background: linear-gradient(118deg, #FFBE6A 0%, #FF943F 46%, #FB7A34 100%);
  color: #FFFFFF;
  box-shadow: 0 14rpx 30rpx -12rpx rgba(251, 122, 52, 0.75);
  overflow: hidden;
  transition: transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease;
}
.btn::after {
  content: "";
  position: absolute; top: 0; bottom: 0; left: -60%; width: 40%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.5), transparent);
  transform: skewX(-18deg);
  animation: sweep 3.8s ease-in-out infinite;
}
@keyframes sweep {
  0%, 68% { left: -60%; }
  100% { left: 130%; }
}
.btn:active { transform: scale(0.978); box-shadow: 0 8rpx 18rpx -10rpx rgba(251, 122, 52, 0.7); }
.btn-block { width: 100%; }
.btn-sm { height: 64rpx; font-size: 24rpx; padding: 0 30rpx; letter-spacing: 0; box-shadow: none; }
.btn-sm::after { display: none; }
.btn-ghost {
  background: #FFFFFF; color: #D9782A;
  border: 1rpx solid rgba(232, 138, 58, 0.42); box-shadow: none;
}
.btn-ghost::after { display: none; }
.btn-plain { background: #F2F6FD; color: #3C4B62; box-shadow: none; }
.btn-plain::after { display: none; }
.btn-disabled { background: #E8EDF6; color: #A3AEBF; box-shadow: none; }
.btn-disabled::after { display: none; }
.btn-danger { background: #FFF1F1; color: #D8453C; border: 1rpx solid rgba(216, 69, 60, 0.28); box-shadow: none; }
.btn-danger::after { display: none; }
button.btn { width: auto; margin: 0; line-height: normal; }
button.btn::after { border: none; }
button.btn-sm { padding: 0 26rpx; }
button { font-family: inherit; }

/* —— 表单 —— */
.field { margin-bottom: 28rpx; }
.field-label { font-size: 25rpx; color: #5A6779; margin-bottom: 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.field-label .opt { font-size: 21rpx; color: #9AA5B5; flex: none; }
.input, .textarea {
  background: #F6F8FC;
  border: 1rpx solid rgba(22, 35, 58, 0.09);
  border-radius: 18rpx;
  color: #16233A; font-size: 28rpx; width: 100%; box-sizing: border-box;
  transition: border-color 0.2s ease, background 0.2s ease;
}
/* input 是原生组件，自身高度只有约 1.4rem；旧写法给了 24rpx 上下 padding 又没定高，
   盒模型把内容区挤到只剩几个像素，用户输入的文字只能看见半截。
   现在固定高度、纵向 padding 归零，文字靠 line-height 居中。 */
.input { height: 92rpx; padding: 0 26rpx; line-height: 92rpx; }
.textarea { padding: 22rpx 26rpx; height: 200rpx; line-height: 1.65; }
.input-focus { border-color: rgba(232, 138, 58, 0.62); background: #FFF9F2; }
.input-ph { color: #AAB4C2; }
.counter { position: absolute; right: 22rpx; bottom: 16rpx; font-size: 20rpx; color: #AAB4C2; }
.counter.warn { color: #E08A22; }

/* —— 胶囊 / chips —— */
.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 14rpx 24rpx; margin: 0 14rpx 14rpx 0;
  border-radius: 14rpx;
  background: #F6F8FC; border: 1rpx solid rgba(22, 35, 58, 0.08);
  font-size: 24rpx; color: #4E5B70;
  display: flex; align-items: center;
  line-height: 1.35;
  transition: all 0.18s ease;
}
.chip.on {
  background: #FFF2E3;
  border-color: #FFB971;
  color: #B4551A; font-weight: 650;
  box-shadow: 0 6rpx 16rpx -10rpx rgba(232, 138, 58, 0.6);
}
.chip-sm { padding: 9rpx 20rpx; font-size: 22rpx; margin: 0 12rpx 12rpx 0; border-radius: 12rpx; }
.chip-scroll { white-space: nowrap; }
.chip-scroll .chip { display: inline-flex; margin-bottom: 0; }

.pill {
  display: inline-flex; align-items: center;
  padding: 5rpx 16rpx; border-radius: 999rpx;
  font-size: 20rpx; font-weight: 500; line-height: 1.7;
  border: 1rpx solid transparent;
  flex: none;
}
.pill::before { content: ""; width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; margin-right: 8rpx; opacity: 0.9; }
.pill-gold { background: #FFF4E4; color: #C57A1E; border-color: rgba(232, 162, 74, 0.3); }
.pill-green { background: #EAF9F1; color: #15955F; border-color: rgba(21, 149, 95, 0.22); }
.pill-red { background: #FFF0F0; color: #D8453C; border-color: rgba(216, 69, 60, 0.22); }
.pill-blue { background: #EDF3FF; color: #3A6BE0; border-color: rgba(58, 107, 224, 0.22); }
.pill-gray { background: #F3F5F9; color: #6E7B8E; border-color: rgba(22, 35, 58, 0.07); }
.pill-violet { background: #F2EFFF; color: #6B57D6; border-color: rgba(107, 87, 214, 0.22); }
.pill-no-dot::before { display: none; }

/* —— 顶部导航（自定义）—— */
.nav {
  position: sticky; top: 0; z-index: 60;
  padding: 0 32rpx; box-sizing: border-box;
  transition: background 0.25s ease, border-color 0.25s ease, backdrop-filter 0.25s ease;
  border-bottom: 1rpx solid transparent;
}
.nav-solid {
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(24rpx);
  border-bottom-color: rgba(22, 35, 58, 0.07);
}
.nav-inner { height: 96rpx; display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; }
.brand-mark {
  position: relative;
  width: 66rpx; height: 66rpx; border-radius: 20rpx; margin-right: 16rpx;
  background: linear-gradient(145deg, #FFCE83, #FF8A3D);
  color: #FFFFFF; font-size: 32rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 22rpx -10rpx rgba(255, 138, 61, 0.85), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
  flex: none;
}
.brand-mark::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.6) 48%, transparent 66%);
  transform: translateX(-120%);
  animation: markShine 5s ease-in-out infinite;
}
@keyframes markShine { 0%, 55% { transform: translateX(-120%); } 85%, 100% { transform: translateX(120%); } }
.brand-name { font-size: 31rpx; font-weight: 750; color: #16233A; letter-spacing: 1rpx; line-height: 1.25; }
.brand-sub { font-size: 19rpx; color: #93A0B2; letter-spacing: 2rpx; margin-top: 2rpx; }
.nav-right { display: flex; align-items: center; flex: none; }

/* —— Hero —— */
.hero { position: relative; padding: 8rpx 40rpx 40rpx; overflow: hidden; }
.hero-kicker {
  display: inline-flex; align-items: center;
  font-size: 20rpx; letter-spacing: 2rpx; color: #C07A24;
  border: 1rpx solid rgba(232, 162, 74, 0.32); border-radius: 999rpx;
  padding: 7rpx 20rpx; margin-bottom: 24rpx;
  background: #FFF8EC;
}
.hero-title { font-size: 58rpx; font-weight: 800; line-height: 1.28; letter-spacing: -0.5rpx; color: #16233A; }
.hero-title .accent,
.accent-text {
  background: linear-gradient(108deg, #FF9A45 0%, #FF7A45 52%, #F0603A 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.hero-desc { font-size: 25rpx; color: #5A6779; margin-top: 14rpx; line-height: 1.7; }
.hero-chips { display: flex; align-items: center; flex-wrap: wrap; margin-top: 26rpx; }
.balance-pill {
  display: inline-flex; align-items: center;
  padding: 10rpx 22rpx; border-radius: 999rpx; white-space: nowrap;
  background: #FFF4E4;
  border: 1rpx solid rgba(232, 162, 74, 0.38);
  color: #BE7218; font-size: 23rpx; font-weight: 650;
}
.hero-stat { font-size: 22rpx; color: #8B95A5; margin-right: 22rpx; }
.hero-stat .gold { font-weight: 700; }

/* —— 区块标题 —— */
.section { margin: 36rpx 4rpx 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-title { position: relative; font-size: 31rpx; font-weight: 700; color: #16233A; padding-left: 20rpx; line-height: 1.4; }
.section-title::before {
  content: ""; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 6rpx; height: 28rpx; border-radius: 999rpx;
  background: linear-gradient(180deg, #FFB067, #FF8A3D);
}
.section-sub { font-size: 22rpx; color: #9AA5B5; margin-left: 10rpx; flex: none; }
.section-more { font-size: 23rpx; color: #D97A25; flex: none; }
.rule { height: 1rpx; background: linear-gradient(90deg, rgba(22, 35, 58, 0.1), rgba(22, 35, 58, 0)); margin: 24rpx 0; }
.hairline { height: 1rpx; background: rgba(22, 35, 58, 0.07); margin: 22rpx 0; }

/* —— 封面 / 缩略图 —— */
.cover {
  position: relative; overflow: hidden; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  flex: none;
}
.cover::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.22), transparent 46%, rgba(20, 40, 80, 0.14));
  pointer-events: none;
}
.cover-char {
  font-size: 88rpx; font-weight: 800; color: #FFFFFF;
  text-shadow: 0 6rpx 18rpx rgba(40, 60, 100, 0.28);
  letter-spacing: 2rpx;
}
.cover-a { background: linear-gradient(145deg, #B5AEFF, #8E7BFF 55%, #6D5BE0); }
.cover-b { background: linear-gradient(145deg, #8FE3E0, #43C3C9 55%, #2FA9BC); }
.cover-c { background: linear-gradient(145deg, #FFCB8A, #F09A56 55%, #D97C3C); }
.cover-d { background: linear-gradient(145deg, #A9C4FF, #6E8CE8 55%, #4C69C9); }
.cover-e { background: linear-gradient(145deg, #FFB3BE, #F0788F 55%, #D55470); }
.cover-f { background: linear-gradient(145deg, #BCE49A, #7FBF5E 55%, #5C9B42); }
.ai-badge {
  position: absolute; left: 12rpx; bottom: 12rpx; z-index: 2;
  padding: 3rpx 10rpx; border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.82); color: #4E5B70;
  font-size: 17rpx; letter-spacing: 0.5rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

/* —— 进度 —— */
.progress { height: 8rpx; background: rgba(22, 35, 58, 0.08); border-radius: 999rpx; overflow: hidden; }
.progress-bar {
  position: relative; height: 100%; border-radius: 999rpx;
  background: linear-gradient(90deg, #FFC57E, #FF943F 55%, #FB7A34);
  transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 进度环：外圈 conic-gradient，由 JS 生成 style */
.ring {
  position: relative; width: 130rpx; height: 130rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex: none;
}
.ring-inner {
  position: absolute; inset: 10rpx; border-radius: 50%;
  background: #FFFFFF; display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 14rpx -8rpx rgba(24, 50, 102, 0.4);
}
.ring-value { font-size: 32rpx; font-weight: 800; color: #16233A; line-height: 1.15; }
.ring-label { font-size: 17rpx; color: #93A0B2; letter-spacing: 0.5rpx; }

/* —— 数据 —— */
.stat { flex: 1; min-width: 0; text-align: center; }
.stat-value { font-size: 42rpx; font-weight: 800; color: #16233A; letter-spacing: 0.5rpx; line-height: 1.15; }
.stat-value small { font-size: 21rpx; font-weight: 500; color: #93A0B2; margin-left: 4rpx; }
.stat-label { font-size: 21rpx; color: #8B95A5; margin-top: 6rpx; letter-spacing: 0.5rpx; }
.stat-divider { width: 1rpx; height: 48rpx; background: linear-gradient(180deg, transparent, rgba(22, 35, 58, 0.12), transparent); flex: none; }
.stat-tile {
  flex: 1; min-width: 0; padding: 22rpx 10rpx; border-radius: 18rpx; text-align: center;
  background: #F6F8FC; border: 1rpx solid rgba(22, 35, 58, 0.06);
}
.stat-row { display: flex; gap: 16rpx; }
.stat-num {
  font-size: 40rpx; font-weight: 700; letter-spacing: -0.5rpx;
  color: #16233A; font-variant-numeric: tabular-nums; line-height: 1.2;
}
.stat-num.small { font-size: 30rpx; }

/* —— 列表 —— */
.list-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid rgba(22, 35, 58, 0.06); }
.list-item:last-child { border-bottom: none; }
.list-avatar {
  width: 78rpx; height: 78rpx; border-radius: 22rpx; margin-right: 22rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 700;
}
.list-main { flex: 1; min-width: 0; }
.list-title { font-size: 28rpx; color: #22314A; font-weight: 600; line-height: 1.45; }
.list-sub { font-size: 22rpx; color: #8B95A5; margin-top: 6rpx; line-height: 1.5; }
.list-right { font-size: 24rpx; color: #7C8798; margin-left: 16rpx; text-align: right; flex: none; }
.divider { height: 1rpx; background: rgba(22, 35, 58, 0.06); margin: 8rpx 0; }

.lrow {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.06);
}
.lrow:last-child { border-bottom: none; }
.lrow-main { flex: 1; min-width: 0; }
.lrow-title { font-size: 26rpx; color: #22314A; line-height: 1.45; }
.lrow-sub { margin-top: 6rpx; font-size: 20rpx; color: #8B95A5; line-height: 1.5; }
.lrow-right { text-align: right; flex: none; }
.lrow-arrow { color: #B6C0CE; font-size: 30rpx; flex: none; }
.lrow-amount { font-size: 27rpx; font-weight: 600; color: #16233A; font-variant-numeric: tabular-nums; }
.lrow-amount.plus { color: #15955F; }
.lrow-amount.minus { color: #D8453C; }

/* —— 空态 / 错误 / 骨架 —— */
.empty { padding: 68rpx 30rpx; text-align: center; }
.empty-icon {
  width: 108rpx; height: 108rpx; border-radius: 32rpx; margin: 0 auto 22rpx;
  background: linear-gradient(150deg, #FFF6EA, #F3F7FE);
  border: 1rpx solid rgba(232, 162, 74, 0.22);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: #D79A55;
  box-shadow: 0 12rpx 26rpx -16rpx rgba(24, 50, 102, 0.4);
}
.empty-title { font-size: 28rpx; color: #22314A; font-weight: 650; line-height: 1.45; }
.empty-sub { font-size: 23rpx; color: #8B95A5; margin-top: 10rpx; line-height: 1.7; }
.error-box { padding: 24rpx; border-radius: 18rpx; background: #FFF2F2; border: 1rpx solid rgba(216, 69, 60, 0.2); }
.error-text { font-size: 24rpx; color: #C93F37; line-height: 1.6; }
.skeleton {
  border-radius: 16rpx;
  background: linear-gradient(100deg, #EDF1F8 30%, #F7FAFE 50%, #EDF1F8 70%);
  background-size: 220% 100%;
  animation: shimmer 1.3s linear infinite;
}
@keyframes shimmer { from { background-position: 140% 0; } to { background-position: -40% 0; } }
.sk-line { height: 24rpx; margin-bottom: 16rpx; }
.sk-block { height: 180rpx; margin-bottom: 20rpx; border-radius: 26rpx; }

/* —— 分段 tab —— */
.seg {
  position: relative;
  display: flex; padding: 6rpx;
  background: #F1F4FA; border: 1rpx solid rgba(22, 35, 58, 0.06);
  border-radius: 999rpx; margin-bottom: 24rpx;
}
.seg-item {
  flex: 1; text-align: center; padding: 14rpx 4rpx;
  font-size: 24rpx; color: #6E7B8E; border-radius: 999rpx;
  line-height: 1.4;
  transition: color 0.2s ease, background 0.24s ease;
}
.seg-item.on {
  color: #B4551A; font-weight: 650;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx -10rpx rgba(24, 50, 102, 0.45);
}
/* 滑动指示器：各页用 inline style 控制 left/width/transform */
.seg-ind {
  position: absolute;
  top: 6rpx; bottom: 6rpx; left: 6rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 16rpx -10rpx rgba(24, 50, 102, 0.45);
  transition: left 0.26s cubic-bezier(0.16, 0.84, 0.28, 1), width 0.26s cubic-bezier(0.16, 0.84, 0.28, 1);
  pointer-events: none;
  z-index: 0;
}
.seg-item { position: relative; z-index: 1; }
.tabs { display: flex; background: #F1F4FA; border: 1rpx solid rgba(22, 35, 58, 0.06); border-radius: 18rpx; padding: 6rpx; margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 4rpx; font-size: 24rpx; color: #6E7B8E; border-radius: 14rpx; line-height: 1.4; }
.tab-on { background: #FFFFFF; color: #16233A; font-weight: 650; box-shadow: 0 6rpx 16rpx -10rpx rgba(24, 50, 102, 0.4); }
.tab-scroll { white-space: nowrap; }
.tab-scroll .tab { display: inline-block; padding: 14rpx 24rpx; }

/* —— 流程节点 —— */
.node { display: flex; }
.node-rail { width: 46rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.node-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%;
  background: #D7DEE9; border: 3rpx solid #FFFFFF; margin-top: 12rpx;
  box-shadow: 0 0 0 1rpx rgba(22, 35, 58, 0.06);
  transition: all 0.3s ease;
}
.node-dot.done { background: #22B07D; box-shadow: 0 0 0 1rpx rgba(34, 176, 125, 0.3); }
.node-dot.running { background: #FF943F; animation: dotPulse 1.6s ease-in-out infinite; }
.node-dot.failed { background: #E5544B; }
.node-dot.skipped { background: #B6C0CE; }
@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 148, 63, 0.4); }
  50% { box-shadow: 0 0 0 10rpx rgba(255, 148, 63, 0.06); }
}
.node-line { flex: 1; width: 2rpx; background: linear-gradient(180deg, rgba(255, 148, 63, 0.5), rgba(22, 35, 58, 0.08)); margin: 8rpx 0; }
.node-body { flex: 1; padding: 0 0 32rpx 10rpx; min-width: 0; }
.node-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.node-name { font-size: 26rpx; color: #22314A; font-weight: 600; }
.node-meta { font-size: 21rpx; color: #8B95A5; margin-top: 5rpx; }

/* —— 底部弹层 —— */
.sheet-mask {
  position: fixed; inset: 0; background: rgba(20, 32, 55, 0.42);
  backdrop-filter: blur(4rpx);
  z-index: 900;
  animation: maskIn 0.2s ease both;
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 901;
  width: 100%; background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 86vh; box-sizing: border-box;
  border-top: 1rpx solid rgba(22, 35, 58, 0.06);
  box-shadow: 0 -12rpx 40rpx -18rpx rgba(24, 50, 102, 0.4);
  animation: sheetUp 0.32s cubic-bezier(0.16, 1.02, 0.3, 1) both;
}
@keyframes sheetUp { from { transform: translate3d(0, 100%, 0); } to { transform: translate3d(0, 0, 0); } }
.sheet-bar { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #DFE6F1; margin: 10rpx auto 22rpx; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; gap: 16rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; color: #16233A; line-height: 1.4; }
.sheet-close { font-size: 25rpx; color: #8B95A5; padding: 6rpx 10rpx; flex: none; }
.sheet-scroll { max-height: 62vh; }

/* —— 价格 / 套餐 —— */
.pkg {
  flex: 1; border: 1rpx solid rgba(22, 35, 58, 0.08); border-radius: 22rpx;
  padding: 26rpx 16rpx; text-align: center;
  background: #F9FBFE;
  position: relative; transition: all 0.2s ease;
}
.pkg.on {
  border-color: #FFB971;
  background: linear-gradient(160deg, #FFF4E4, #FFFFFF);
  transform: translateY(-4rpx);
  box-shadow: 0 14rpx 30rpx -18rpx rgba(232, 138, 58, 0.8);
}
.pkg-points { font-size: 40rpx; font-weight: 800; color: #16233A; }
.pkg-points small { font-size: 20rpx; color: #8B95A5; margin-left: 4rpx; font-weight: 400; }
.pkg-price { font-size: 24rpx; color: #D97A25; margin-top: 8rpx; }
.pkg-tag {
  position: absolute; top: -14rpx; right: 14rpx;
  background: linear-gradient(120deg, #FFBE6A, #FB7A34); color: #FFFFFF; font-size: 18rpx;
  padding: 3rpx 12rpx; border-radius: 8rpx; font-weight: 700;
}

/* —— 提示条 —— */
.notice {
  display: flex; align-items: flex-start;
  padding: 20rpx 22rpx; border-radius: 18rpx;
  background: #FFF8EC;
  border: 1rpx solid rgba(232, 162, 74, 0.26);
  font-size: 22rpx; color: #9A6A24; line-height: 1.62;
}
.notice-dark { background: #F5F8FD; border-color: rgba(22, 35, 58, 0.07); color: #6E7B8E; }
.dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #E8A24A; margin-right: 12rpx; flex-shrink: 0; margin-top: 13rpx; }
.link { color: #D97A25; }
.footer-note { text-align: center; font-size: 20rpx; color: #A3AEBE; line-height: 1.8; padding: 30rpx 20rpx 10rpx; }
.tag-ai { font-size: 18rpx; color: #6B57D6; border: 1rpx solid rgba(107, 87, 214, 0.3); border-radius: 6rpx; padding: 2rpx 8rpx; }

/* —— 动效工具类 —— */
.rise { animation: rise 0.52s cubic-bezier(0.16, 0.84, 0.28, 1) both; }
@keyframes rise { from { opacity: 0; transform: translate3d(0, 26rpx, 0); } to { opacity: 1; transform: none; } }
.d1 { animation-delay: 0.04s; } .d2 { animation-delay: 0.08s; } .d3 { animation-delay: 0.12s; }
.d4 { animation-delay: 0.16s; } .d5 { animation-delay: 0.2s; } .d6 { animation-delay: 0.24s; }
.d7 { animation-delay: 0.28s; } .d8 { animation-delay: 0.32s; } .d9 { animation-delay: 0.36s; } .d10 { animation-delay: 0.4s; }
.float { animation: floatY 4.4s ease-in-out infinite; }
@keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
.breathe { animation: breathe 3.4s ease-in-out infinite; }
@keyframes breathe { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
.spin { animation: spin 1.1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ============================================================
   数据与账号（v3 增量的浅色版）
   ============================================================ */

.glass {
  position: relative;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 35, 58, 0.07);
  box-shadow: 0 12rpx 32rpx -18rpx rgba(24, 50, 102, 0.28);
  overflow: hidden;
}
.glass::after {
  content: "";
  position: absolute; inset: 0;
  background: radial-gradient(120% 80% at 100% 0%, rgba(255, 190, 120, 0.14), rgba(255, 190, 120, 0) 62%);
  pointer-events: none;
}

/* —— 柱状图（纯 CSS，不引图表库） —— */
.bars { display: flex; align-items: flex-end; gap: 14rpx; height: 180rpx; }
.bar-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar-fill {
  width: 100%; border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #FFC57E, #FF943F);
  animation: barRise 0.62s cubic-bezier(0.2, 0.9, 0.2, 1) both;
  transform-origin: bottom center;
}
.bar-fill.alt { background: linear-gradient(180deg, #A9A0FF, #7C6BF0); }
.bar-label { margin-top: 10rpx; font-size: 19rpx; color: #8B95A5; }
@keyframes barRise { from { transform: scaleY(0.02); opacity: 0.2; } to { transform: scaleY(1); opacity: 1; } }

/* —— 输入行（登录/设置复用） —— */
.field-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 22rpx; margin-top: 16rpx;
  border-radius: 18rpx;
  background: #F6F8FC;
  border: 1rpx solid rgba(22, 35, 58, 0.09);
  transition: border-color 0.2s ease, background 0.2s ease;
}
.field-row.focus { border-color: rgba(232, 138, 58, 0.6); background: #FFF9F2; }
.field-input { flex: 1; min-width: 0; font-size: 27rpx; color: #16233A; line-height: 1.5; }
.field-ph { color: #AAB4C2; font-size: 26rpx; }
.field-btn {
  flex: none; padding: 10rpx 22rpx; border-radius: 999rpx;
  font-size: 22rpx; color: #C57A1E; white-space: nowrap;
  background: #FFF4E4;
  border: 1rpx solid rgba(232, 162, 74, 0.4);
}
.field-btn.off { color: #A3AEBE; background: #EFF3F9; border-color: rgba(22, 35, 58, 0.06); }

/* —— 标签 —— */
.tag {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 999rpx;
  font-size: 19rpx; color: #5A6779; white-space: nowrap;
  background: #F3F5F9;
  border: 1rpx solid rgba(22, 35, 58, 0.07);
}
.tag.gold { color: #C57A1E; background: #FFF4E4; border-color: rgba(232, 162, 74, 0.34); }
.tag.violet { color: #6B57D6; background: #F2EFFF; border-color: rgba(107, 87, 214, 0.24); }

/* ============================================================
   账号中心 / 设置（v4.9）：成组的设置行，左标题右值，右箭头
   ============================================================ */
.cellgroup {
  background: #FFFFFF; border-radius: 24rpx; overflow: hidden;
  border: 1rpx solid rgba(22, 35, 58, 0.07);
  box-shadow: 0 12rpx 32rpx -20rpx rgba(24, 50, 102, 0.26);
  margin-bottom: 22rpx;
}
.cellgroup-title {
  padding: 22rpx 26rpx 6rpx;
  font-size: 21rpx; color: #93A0B2; letter-spacing: 1rpx;
}
.cell {
  display: flex; align-items: center; gap: 18rpx;
  padding: 26rpx; position: relative;
}
.cell + .cell::before {
  content: ""; position: absolute; left: 26rpx; right: 0; top: 0; height: 1rpx;
  background: rgba(22, 35, 58, 0.06);
}
.cell-icon {
  width: 60rpx; height: 60rpx; border-radius: 18rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #C57A1E; background: #FFF4E4;
}
.cell-main { flex: 1; min-width: 0; }
.cell-k { font-size: 27rpx; color: #22314A; font-weight: 550; line-height: 1.45; }
.cell-d { font-size: 21rpx; color: #93A0B2; margin-top: 4rpx; line-height: 1.5; }
.cell-v { font-size: 25rpx; color: #6E7B8E; flex: none; max-width: 46%; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cell-arrow { color: #C3CCDA; font-size: 28rpx; flex: none; }
.cell-arrow.v { color: #B6C0CE; }

/* 额度条 */
.quota-bar { height: 14rpx; border-radius: 999rpx; background: #EDF1F8; overflow: hidden; }
.quota-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #FFC57E, #FF943F); transition: width 0.6s ease; }
.quota-fill.warn { background: linear-gradient(90deg, #FFB067, #E5544B); }

/* 危险区 */
.danger-zone { margin-top: 10rpx; }
.danger-note { font-size: 21rpx; color: #A3AEBE; line-height: 1.6; margin-top: 12rpx; }
