<view class="screen {{pageAnim ? 'screen-in' : ''}}">
  <view class="aurora">
    <view class="aurora-a"></view>
    <view class="aurora-b"></view>
  </view>

  <view class="layer page">
    <view class="head between">
      <view class="flex1">
        <view class="title">收益看板</view>
        <view class="sub">你在分发页回填的每一笔，这里都会自动汇总</view>
      </view>
      <view class="rank-link tap" hover-class="tap-on" bindtap="goRank">排行榜 ›</view>
    </view>

    <view wx:if="{{loading}}" class="glass card">
      <view class="skeleton" style="height:60rpx;width:60%"></view>
      <view class="skeleton mt16" style="height:140rpx"></view>
    </view>

    <block wx:elif="{{error}}">
      <view class="glass card">
        <view class="err">{{error}}</view>
        <view class="btn btn-block mt16 tap" hover-class="tap-on" bindtap="load">重试</view>
      </view>
    </block>

    <block wx:else>
      <!-- 总览 -->
      <view class="glass card hero">
        <view class="hero-label">累计回填收益（元）</view>
        <view class="hero-num">{{total}}</view>
        <view class="stat-row mt16">
          <view class="stat">
            <view class="stat-num small">{{settled}}</view>
            <view class="stat-label">已结算</view>
          </view>
          <view class="stat">
            <view class="stat-num small">{{pending}}</view>
            <view class="stat-label">待结算</view>
          </view>
          <view class="stat">
            <view class="stat-num small">{{published}}</view>
            <view class="stat-label">已上线分发</view>
          </view>
        </view>
      </view>

      <!-- 额度预警：只说「偏低/用完」，不预测还能出几集（预测一定会失真） -->
      <view wx:if="{{quota && quota.level !== 'ok'}}" class="quota-bar {{quota.level}}">
        <view class="quota-main">
          <view class="quota-title">{{quota.level === 'empty' ? '点数已用完' : '点数偏低'}}</view>
          <view class="quota-sub">{{quota.note}}</view>
        </view>
        <view class="quota-btn tap" hover-class="tap-on" bindtap="goRecharge">去充值</view>
      </view>

      <!-- 待回填：已上线但还没填收益，一次填完 -->
      <view wx:if="{{unfilled.length}}" class="glass card">
        <view class="fill-head">
          <view>
            <view class="card-title" style="margin-bottom:6rpx">待回填收益</view>
            <view class="fill-sub">{{unfilled.length}} 条已上线分发还没有金额</view>
          </view>
          <view class="fill-btn tap" hover-class="tap-on" bindtap="openFill">一键回填</view>
        </view>
      </view>

      <!-- 对账单：复制 CSV 粘到 Excel -->
      <view wx:if="{{total > 0}}" class="glass card">
        <view class="fill-head">
          <view>
            <view class="card-title" style="margin-bottom:6rpx">本月对账单</view>
            <view class="fill-sub">导出 CSV 复制到 Excel / WPS 对账</view>
          </view>
          <view class="ghost-btn tap" hover-class="tap-on" bindtap="exportBill">{{exporting ? '导出中…' : '导出'}}</view>
        </view>
      </view>

      <!-- 月度趋势 -->
      <view class="glass card" wx:if="{{bars.length}}">
        <view class="card-title">近半年</view>
        <view class="bars">
          <view class="bar-col" wx:for="{{bars}}" wx:key="month">
            <view class="bar-fill" style="height:{{item.h}}rpx"></view>
            <view class="bar-label">{{item.month}}</view>
          </view>
        </view>
      </view>

      <!-- 平台 -->
      <view class="glass card" wx:if="{{platforms.length}}">
        <view class="card-title">按平台</view>
        <view class="lrow" wx:for="{{platforms}}" wx:key="platform_code">
          <view class="lrow-main">
            <view class="lrow-title">{{item.platform_name}}</view>
            <view class="lrow-sub">{{item.count}} 条分发记录</view>
          </view>
          <view class="lrow-right">
            <view class="lrow-amount">{{item.amount}}</view>
          </view>
        </view>
      </view>

      <!-- 项目 -->
      <view class="glass card" wx:if="{{projects.length}}">
        <view class="card-title">按项目</view>
        <view class="lrow tap" hover-class="tap-on" wx:for="{{projects}}" wx:key="project_id"
              data-id="{{item.project_id}}" bindtap="openProject">
          <view class="lrow-main">
            <view class="lrow-title">
              <text wx:if="{{item.index_label}}" class="idx">{{item.index_label}}</text>{{item.title}}
            </view>
            <view class="lrow-sub">{{item.distributions}} 条分发</view>
          </view>
          <view class="lrow-right">
            <view class="lrow-amount">{{item.amount}}</view>
          </view>
        </view>
      </view>

      <!-- 空态 -->
      <view wx:if="{{!bars.length && !projects.length}}" class="glass card empty">
        <view class="empty-title">还没有收益数据</view>
        <view class="empty-sub">{{note}}</view>
        <view class="btn btn-block mt24 tap" hover-class="tap-on" bindtap="goDistribute">去分发页回填</view>
      </view>

      <view wx:else class="hint mt16">{{note}}</view>
    </block>
  </view>

  <!-- 批量回填抽屉 -->
  <view wx:if="{{fillOpen}}" class="sheet-mask" bindtap="closeFill" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-bar"></view>
      <view class="sheet-head">
        <view class="sheet-title">回填收益</view>
        <view class="sheet-close" bindtap="closeFill">关闭</view>
      </view>
      <view class="field-label">
        <text>账期</text>
        <text class="opt">{{fillPeriod}}（按平台结算单填）</text>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view wx:for="{{fillRows}}" wx:key="distribution_id" class="fill-row">
          <view class="fill-row-top">
            <view class="fill-row-name">{{item.platform_name}}</view>
            <view class="fill-row-title">{{item.title}}</view>
          </view>
          <view class="fill-row-ctrl">
            <input
              class="fill-input"
              type="digit"
              placeholder="0.00"
              placeholder-class="input-ph"
              value="{{item.amount}}"
              data-i="{{index}}"
              bindinput="onAmount"
              cursor-spacing="180"
            />
            <view class="seg tiny">
              <view class="seg-item {{item.settle === '待结算' ? 'on' : ''}}" data-i="{{index}}" data-v="待结算" bindtap="pickSettle">待结算</view>
              <view class="seg-item {{item.settle === '已结算' ? 'on' : ''}}" data-i="{{index}}" data-v="已结算" bindtap="pickSettle">已结算</view>
            </view>
          </view>
        </view>
        <view wx:if="{{!fillRows.length}}" class="hint mt16">没有待回填的记录</view>
      </scroll-view>
      <view class="btn btn-block mt16 {{submitting ? 'btn-disabled' : 'tap'}}" hover-class="{{submitting ? '' : 'tap-on'}}" bindtap="submitFill">
        {{submitting ? '正在写入…' : '提交回填'}}
      </view>
      <view class="hint mt8">没填金额的行会被跳过；金额填 0 表示该条确实没有收益。</view>
    </view>
  </view>
</view>
