/* ============================================================
   协议中心 · 夜戏设计系统 v2（长文阅读优化）
   ============================================================ */

.legal-top {
  position: sticky; top: 0; z-index: 60;
  padding: 16rpx 28rpx 14rpx;
  background: rgba(6, 7, 12, 0.78);
  backdrop-filter: blur(24rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}
.legal-seg { margin-bottom: 0; }

.legal-layer { padding: 30rpx 32rpx 0; box-sizing: border-box; }

/* —— 文档头 —— */
.doc-head { padding-bottom: 26rpx; animation: rise 0.46s cubic-bezier(0.16, 0.84, 0.28, 1) both; }
.doc-head .h1 { font-size: 54rpx; letter-spacing: 1rpx; }
.doc-meta { display: flex; align-items: center; margin-top: 18rpx; }
.doc-meta .tiny { margin-left: 14rpx; }

/* —— 引言 —— */
.intro-card {
  position: relative;
  padding: 28rpx 28rpx 28rpx 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(158deg, rgba(243, 201, 105, 0.09), rgba(243, 201, 105, 0.015));
  border: 1rpx solid rgba(243, 201, 105, 0.18);
  animation: rise 0.5s cubic-bezier(0.16, 0.84, 0.28, 1) 0.05s both;
}
.intro-card::before {
  content: ""; position: absolute; left: 0; top: 26rpx; bottom: 26rpx; width: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #F3C969, rgba(243, 201, 105, 0.1));
}
.intro-mark {
  position: absolute; right: 24rpx; top: 4rpx;
  font-size: 92rpx; line-height: 1; color: rgba(243, 201, 105, 0.16);
  font-weight: 800;
}
.intro-text { font-size: 25rpx; color: #B9C2D2; line-height: 1.82; position: relative; z-index: 2; }

/* —— 章节 —— */
.sec { margin-top: 40rpx; }
.sec-head { display: flex; align-items: baseline; margin-bottom: 16rpx; }
.sec-no {
  font-size: 22rpx; color: #F3C969; font-weight: 800;
  background: rgba(243, 201, 105, 0.1);
  border: 1rpx solid rgba(243, 201, 105, 0.22);
  border-radius: 10rpx; padding: 3rpx 12rpx;
  margin-right: 16rpx; flex-shrink: 0;
}
.sec-title { font-size: 31rpx; font-weight: 700; color: #FFFFFF; letter-spacing: 0.4rpx; }
.sec-para {
  font-size: 25rpx; color: #98A3B6; line-height: 1.88;
  margin-bottom: 16rpx; text-align: justify;
}

/* —— 联系 —— */
.contact-card {
  margin-top: 44rpx; padding: 26rpx 26rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.contact-mail {
  margin-top: 22rpx; padding-top: 20rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.1);
  font-size: 24rpx; color: #F3C969; word-break: break-all;
}
