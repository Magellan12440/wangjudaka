/* 项目详情：剧组工作台 */

/* —— 英雄区 —— */
.p-hero {
  position: relative;
  padding: 30rpx 32rpx 34rpx;
  overflow: hidden;
}
.p-hero-bg {
  position: absolute; top: -80rpx; left: -40rpx; right: -40rpx; height: 420rpx;
  opacity: 0.42;
  filter: saturate(0.85);
}
.p-hero-bg::after {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(60% 80% at 78% 12%, rgba(22, 35, 58, 0.28), transparent 60%);
}
.p-hero-fade {
  position: absolute; top: 0; left: 0; right: 0; height: 420rpx;
  background: linear-gradient(180deg, rgba(6, 7, 12, 0.1) 0%, rgba(6, 7, 12, 0.66) 58%, #F4F7FD 100%);
}
.p-hero-inner { position: relative; z-index: 2; padding-top: 120rpx; }
.p-season {
  display: inline-flex; align-items: center;
  padding: 5rpx 16rpx; border-radius: 999rpx;
  font-size: 19rpx; letter-spacing: 2rpx; color: #E8D3A5;
  background: rgba(20, 32, 55, 0.34);
  border: 1rpx solid rgba(232, 145, 47, 0.3);
}
.p-title { font-size: 46rpx; font-weight: 800; color: #16233A; line-height: 1.26; margin-top: 18rpx; letter-spacing: 0.5rpx; }
.p-meta { font-size: 22rpx; color: #4A566B; margin-top: 10rpx; }

.p-progress-row {
  display: flex; align-items: center;
  margin-top: 28rpx; padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(22, 35, 58, 0.055);
  border: 1rpx solid rgba(22, 35, 58, 0.09);
}
.ring-pct { font-size: 20rpx; font-weight: 500; color: #6E7B8E; margin-left: 2rpx; }
.p-next { display: flex; align-items: center; font-size: 21rpx; color: #8B95A5; margin-top: 16rpx; }
.p-next-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%; margin-right: 10rpx;
  background: #E08A22; box-shadow: 0 0 10rpx rgba(232, 145, 47, 0.8);
  animation: breathe 2s ease-in-out infinite;
}
.p-next-dot.done { background: #22B07D; box-shadow: 0 0 10rpx rgba(34, 176, 125, 0.7); }

.p-stats { display: flex; align-items: center; margin-top: 26rpx; }
.p-stat { flex: 1; }
.p-stat-value { font-size: 40rpx; font-weight: 800; color: #16233A; line-height: 1.15; }
.p-stat-label { font-size: 20rpx; color: #8B95A5; margin-top: 4rpx; letter-spacing: 1rpx; }

/* —— 系列条 —— */
.series-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, rgba(124, 107, 240, 0.1), rgba(124, 107, 240, 0.02));
  border: 1rpx solid rgba(124, 107, 240, 0.2);
}
.series-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.series-title { font-size: 25rpx; color: #2A3446; font-weight: 600; }
.series-sub { font-size: 20rpx; color: #8B95A5; margin-top: 4rpx; }

/* —— 素材 —— */
.upload-grid { display: flex; justify-content: space-between; }
.upload-tile {
  width: 23.4%;
  padding: 22rpx 6rpx 18rpx;
  border-radius: 22rpx;
  text-align: center;
  background: rgba(22, 35, 58, 0.035);
  border: 1rpx solid rgba(22, 35, 58, 0.075);
  box-sizing: border-box;
  transition: all 0.2s ease;
}
.upload-icon {
  width: 56rpx; height: 56rpx; margin: 0 auto 12rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #E08A22;
  background: rgba(232, 145, 47, 0.1);
  border: 1rpx solid rgba(232, 145, 47, 0.2);
}
.upload-name { font-size: 21rpx; color: #2A3446; font-weight: 550; }
.upload-sub { font-size: 17rpx; color: #9AA5B5; margin-top: 4rpx; }
.note-input-wrap { position: relative; }
.note-input { height: 76rpx; font-size: 23rpx; padding: 0 22rpx; }
.uploading {
  display: flex; align-items: center;
  margin-top: 18rpx; font-size: 22rpx; color: #E08A22;
}
.uploading-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #E08A22; margin-right: 12rpx;
  animation: breathe 1.2s ease-in-out infinite;
  box-shadow: 0 0 12rpx rgba(232, 145, 47, 0.8);
}

.m-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid rgba(22, 35, 58, 0.06); }
.m-item:last-child { border-bottom: none; }
.m-thumb {
  width: 100rpx; height: 100rpx; border-radius: 20rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(22, 35, 58, 0.05);
  border: 1rpx solid rgba(22, 35, 58, 0.08);
  overflow: hidden;
}
.m-thumb.text { background: linear-gradient(150deg, rgba(232, 145, 47, 0.16), rgba(232, 145, 47, 0.03)); }
.m-thumb.video { background: linear-gradient(150deg, rgba(124, 107, 240, 0.18), rgba(124, 107, 240, 0.03)); }
.m-char { font-size: 32rpx; color: #D98828; font-weight: 600; }
.m-img { width: 100%; height: 100%; }
.m-name { font-size: 26rpx; color: #22314A; font-weight: 550; }
.m-sub { font-size: 20rpx; color: #8B95A5; margin-top: 6rpx; }
.m-note { font-size: 20rpx; color: #8B95A5; margin-top: 6rpx; }
.m-del { font-size: 21rpx; color: #D8453C; padding: 10rpx 6rpx 10rpx 16rpx; flex-shrink: 0; }

/* —— 剧本 —— */
.script-head { border-color: rgba(232, 145, 47, 0.2); }
.script-title { font-size: 40rpx; font-weight: 800; color: #16233A; margin-top: 18rpx; line-height: 1.3; }
.script-logline { font-size: 24rpx; color: #4A566B; margin-top: 12rpx; line-height: 1.62; }
.char-row { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.char-chip {
  display: flex; align-items: center;
  padding: 8rpx 16rpx; margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: rgba(22, 35, 58, 0.05);
  border: 1rpx solid rgba(22, 35, 58, 0.08);
}
.char-code { font-size: 17rpx; color: #E08A22; margin-right: 8rpx; letter-spacing: 0.5rpx; }
.char-name { font-size: 22rpx; color: #3A4658; }

.ep-scroll { width: 100%; white-space: nowrap; margin-bottom: 20rpx; }
.ep-chip {
  display: inline-flex; flex-direction: column; align-items: center;
  padding: 14rpx 26rpx; margin-right: 14rpx;
  border-radius: 18rpx;
  background: rgba(22, 35, 58, 0.04);
  border: 1rpx solid rgba(22, 35, 58, 0.075);
}
.ep-chip.on {
  background: linear-gradient(140deg, rgba(232, 145, 47, 0.2), rgba(232, 145, 47, 0.04));
  border-color: rgba(232, 145, 47, 0.6);
}
.ep-no { font-size: 22rpx; font-weight: 700; color: #4A566B; }
.ep-chip.on .ep-no { color: #C57A1E; }
.ep-scenes { font-size: 17rpx; color: #9AA5B5; margin-top: 2rpx; }

.scene {
  position: relative;
  padding: 24rpx 24rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 22rpx;
  background: rgba(22, 35, 58, 0.033);
  border: 1rpx solid rgba(22, 35, 58, 0.065);
}
.scene-head { display: flex; align-items: center; justify-content: space-between; }
.scene-no { font-size: 20rpx; color: #E08A22; letter-spacing: 1rpx; font-family: "SF Mono", Menlo, monospace; }
.scene-action { font-size: 24rpx; color: #4A566B; line-height: 1.62; margin-top: 12rpx; }
.dialogue { display: flex; align-items: flex-start; margin-top: 12rpx; }
.dlg-speaker { font-size: 19rpx; color: #8B95A5; margin-right: 12rpx; margin-top: 4rpx; flex-shrink: 0; }
.dlg-line { font-size: 25rpx; color: #16233A; line-height: 1.55; }
.scene-lock { font-size: 19rpx; color: #B6C0CE; margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx dashed rgba(22, 35, 58, 0.07); }

/* —— 流程 —— */
.next-node {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 20rpx; padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(232, 145, 47, 0.07);
  border: 1rpx solid rgba(232, 145, 47, 0.16);
}
.next-label { font-size: 20rpx; color: #8B95A5; }
.next-name { font-size: 23rpx; color: #C57A1E; font-weight: 600; }
.nodes { margin-top: 26rpx; }

/* —— 通用键值 —— */
.kv { display: flex; align-items: flex-start; justify-content: space-between; margin-top: 14rpx; }
.kv-k { font-size: 23rpx; color: #8B95A5; }
.kv-v { font-size: 23rpx; color: #2A3446; text-align: right; margin-left: 20rpx; }

.blocker { display: flex; align-items: flex-start; margin-top: 14rpx; }
.blocker-text { flex: 1; font-size: 22rpx; color: #4A566B; margin-left: 12rpx; line-height: 1.55; }
.plan-beat { padding: 16rpx 0; border-bottom: 1rpx solid rgba(22, 35, 58, 0.06); }
.plan-beat:last-child { border-bottom: none; }

/* —— 交付 —— */
.check-item { display: flex; align-items: flex-start; padding: 18rpx 0; border-bottom: 1rpx solid rgba(22, 35, 58, 0.055); }
.check-item:last-child { border-bottom: none; }
.check-icon {
  width: 40rpx; height: 40rpx; border-radius: 50%; margin-right: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #B6C0CE;
  background: rgba(22, 35, 58, 0.05);
  border: 1rpx solid rgba(22, 35, 58, 0.08);
  flex-shrink: 0;
}
.check-icon.ok { color: #15955F; background: linear-gradient(140deg, #3CC78F, #15955F); border-color: transparent; }
.check-label { font-size: 25rpx; color: #2A3446; }

/* —— 镜头生产 —— */
.shot-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: rgba(22, 35, 58, 0.033);
  border: 1rpx solid rgba(22, 35, 58, 0.065);
}
.shot-top { display: flex; align-items: center; justify-content: space-between; }
.shot-no { font-size: 21rpx; color: #E08A22; font-family: "SF Mono", Menlo, monospace; letter-spacing: 1rpx; }
.shot-line { font-size: 25rpx; color: #22314A; margin-top: 12rpx; line-height: 1.55; }
.shot-tags { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.shot-tags .pill { margin-right: 10rpx; }
.shot-thumb-wrap { position: relative; margin-top: 16rpx; border-radius: 18rpx; overflow: hidden; }
.shot-thumb { width: 100%; height: 280rpx; display: block; }
.shot-thumb-tag {
  position: absolute; left: 14rpx; bottom: 14rpx;
  padding: 4rpx 12rpx; border-radius: 8rpx;
  background: rgba(20, 32, 55, 0.54); color: #C57A1E; font-size: 18rpx;
  border: 1rpx solid rgba(232, 145, 47, 0.3);
}
.shot-actions { display: flex; margin-top: 18rpx; }
.mini-btn {
  flex: 1; height: 68rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 23rpx; font-weight: 600; color: #6B3A0C;
  background: linear-gradient(118deg, #FFC978, #E08A22 52%, #FB7A34);
  margin-right: 14rpx;
}
.mini-btn:last-child { margin-right: 0; }
.mini-btn.ghost {
  background: rgba(22, 35, 58, 0.05);
  color: #4A566B;
  border: 1rpx solid rgba(22, 35, 58, 0.1);
}

/* —— 交付：成片与剪辑序列 —— */
.film-box {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(232, 145, 47, 0.07);
  border: 1rpx solid rgba(232, 145, 47, 0.22);
}
.file-row {
  display: flex; align-items: center;
  margin-top: 12rpx; padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(20, 32, 55, 0.32);
}
.file-type {
  flex: none; width: 76rpx;
  font-size: 20rpx; font-weight: 700; color: #C57A1E; letter-spacing: 1rpx;
}
.file-url {
  flex: 1; min-width: 0;
  font-size: 21rpx; color: #4A566B;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cmd-box {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(22, 35, 58, 0.035);
  border: 1rpx dashed rgba(22, 35, 58, 0.14);
}
.cmd-text {
  margin-top: 12rpx; padding: 16rpx;
  border-radius: 14rpx;
  background: #F4F7FD;
  color: #7BD3A9;
  font-size: 20rpx; line-height: 1.6;
  font-family: Menlo, Consolas, monospace;
  word-break: break-all;
  max-height: 300rpx; overflow-y: auto;
}
.cut-row {
  display: flex; align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.05);
}
.cut-row:last-child { border-bottom: none; }
.cut-no {
  flex: none; width: 168rpx;
  font-size: 21rpx; color: #C57A1E; font-weight: 600;
}
.cut-time { font-size: 22rpx; color: #4A566B; line-height: 1.5; }
.cut-line { font-size: 21rpx; color: #8B95A5; margin-top: 6rpx; line-height: 1.5; }

/* —— 一句话成剧进度 —— */
.os-step {
  display: flex; align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.05);
}
.os-step:last-child { border-bottom: none; }
.os-dot {
  flex: none; width: 40rpx; height: 40rpx; border-radius: 50%;
  margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700;
  background: rgba(22, 35, 58, 0.05); color: #8B95A5;
  border: 1rpx solid rgba(22, 35, 58, 0.1);
}
.os-dot.ok { background: rgba(84, 209, 143, 0.16); color: #22B07D; border-color: rgba(84, 209, 143, 0.42); }
.os-dot.cur { background: rgba(232, 145, 47, 0.18); color: #C57A1E; border-color: rgba(232, 145, 47, 0.5); }
.os-dot.bad { background: rgba(242, 108, 108, 0.16); color: #D8453C; border-color: rgba(242, 108, 108, 0.45); }
.os-name { font-size: 24rpx; color: #2A3446; font-weight: 600; margin-bottom: 4rpx; }

/* —— 逐集托管状态 —— */
.ep-state {
  display: flex; align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.05);
}
.ep-state:last-child { border-bottom: none; }
.ep-state-no {
  flex: none; width: 120rpx;
  font-size: 22rpx; color: #C57A1E; font-weight: 600;
  font-family: "SF Mono", Menlo, monospace;
}
.ep-state-sub {
  flex: 1;
  font-size: 21rpx; color: #8B95A5;
}

/* —— V4.4 剪辑打法卡（内置库入口） —— */
.glass-lite {
  border-radius: 24rpx;
  background: rgba(22, 35, 58, 0.035);
  border: 1rpx solid rgba(22, 35, 58, 0.075);
}
.lib-card { padding: 24rpx 22rpx; margin: 20rpx 0; }
.lib-title { font-size: 24rpx; color: #6E7B8E; letter-spacing: 1rpx; margin-bottom: 8rpx; }
.lib-row {
  display: flex; align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.055);
}
.lib-row:last-of-type { border-bottom: none; }
.lib-main { flex: 1; min-width: 0; }
.lib-k { font-size: 20rpx; color: #8B95A5; }
.lib-v { margin-top: 4rpx; font-size: 26rpx; color: #22314A; }
.lib-arrow { flex: none; font-size: 21rpx; color: #E08A22; }
.lib-note { margin-top: 12rpx; font-size: 19rpx; line-height: 1.6; color: #8B95A5; }

/* —— 改编流水线（V4.6）—— */
.adapt-flow {
  margin-bottom: 20rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(120% 100% at 0% 0%, rgba(232, 145, 47, 0.12), rgba(232, 145, 47, 0) 58%),
    rgba(22, 35, 58, 0.035);
  border: 1rpx solid rgba(232, 145, 47, 0.2);
}
.af-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.af-title { font-size: 23rpx; letter-spacing: 2rpx; color: #D98828; }
.af-count { font-size: 22rpx; color: #8B95A5; }
.af-scroll { width: 100%; white-space: nowrap; }
.af-track { display: inline-flex; align-items: flex-start; gap: 8rpx; }
.af-node { width: 108rpx; text-align: center; flex: none; }
.af-dot {
  width: 44rpx; height: 44rpx; margin: 0 auto;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; color: #8B95A5;
  background: rgba(22, 35, 58, 0.05);
  border: 1rpx solid rgba(22, 35, 58, 0.1);
}
.af-node.done .af-dot {
  color: #15955F; background: linear-gradient(140deg, #9FE0BE, #3CC78F); border-color: transparent;
}
.af-node.cur .af-dot {
  color: #6B3A0C; background: linear-gradient(140deg, #FFC978, #FF9A45); border-color: transparent;
  box-shadow: 0 0 0 6rpx rgba(232, 145, 47, 0.16);
  animation: breathe 2.4s ease-in-out infinite;
}
.af-name { margin-top: 10rpx; font-size: 19rpx; color: #8B95A5; }
.af-node.done .af-name { color: #7BA694; }
.af-node.cur .af-name { color: #B4551A; font-weight: 600; }
.af-next {
  margin-top: 16rpx; padding-top: 14rpx;
  border-top: 1rpx solid rgba(22, 35, 58, 0.07);
  font-size: 21rpx; line-height: 1.55; color: #4A566B;
}

/* —— 多项目切换（V4.7）—— */
.p-top { display: flex; gap: 14rpx; margin-bottom: 18rpx; }
.p-top-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #B4551A;
  background: rgba(22, 35, 58, 0.1);
  border: 1rpx solid rgba(22, 35, 58, 0.16);
  backdrop-filter: blur(8rpx);
}
.p-list { max-height: 52vh; margin-top: 8rpx; }
.lrow.on { background: rgba(232, 145, 47, 0.08); border-radius: 16rpx; }
.p-idx {
  display: inline-block; margin-right: 10rpx; padding: 0 10rpx;
  border-radius: 8rpx; font-size: 19rpx; line-height: 30rpx;
  color: #E08A22; background: rgba(232, 145, 47, 0.12);
  font-variant-numeric: tabular-nums;
}
.p-cur { font-size: 20rpx; color: #E08A22; margin-left: 14rpx; flex: none; }
.sheet-cancel { margin-top: 18rpx; text-align: center; font-size: 24rpx; color: #8B95A5; padding: 14rpx 0; }

/* —— 继承上一步的剧本（V4.10）—— */
.inherit-card {
  background: linear-gradient(135deg, #FFF8EE, #FFFDF9);
  border: 1rpx solid rgba(232, 138, 58, 0.22);
}
.inherit-tag {
  display: inline-block;
  font-size: 19rpx; color: #B4551A; background: #FFF1DF;
  border-radius: 8rpx; padding: 3rpx 10rpx;
}
.inherit-title { font-size: 30rpx; font-weight: 650; color: #16233A; margin-top: 10rpx; }
.inherit-go {
  flex: none; margin-left: 16rpx;
  font-size: 22rpx; color: #C4691A; background: #FFFFFF;
  border: 1rpx solid rgba(232, 138, 58, 0.3);
  border-radius: 999rpx; padding: 10rpx 20rpx;
}

/* —— 剧本候选 —— */
.pick-card { }
.cand-list { display: flex; flex-direction: column; gap: 14rpx; }
.cand-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 22rpx; border-radius: 20rpx;
  background: #F7F9FD; border: 1rpx solid rgba(22, 35, 58, 0.06);
}
.cand-item.on {
  background: linear-gradient(135deg, #FFF6EA, #FFFDF9);
  border-color: rgba(232, 138, 58, 0.4);
}
.cand-title { font-size: 27rpx; font-weight: 650; color: #16233A; line-height: 1.4; }
.cand-flag {
  font-size: 18rpx; color: #22B07D; background: #E9F9F1;
  border-radius: 6rpx; padding: 2rpx 8rpx; margin-left: 8rpx;
}
.cand-sub { font-size: 21rpx; color: #8B95A5; margin-top: 4rpx; }
.cand-log { font-size: 21rpx; color: #6E7B8E; margin-top: 6rpx; line-height: 1.5; }
.cand-btn {
  flex: none; font-size: 22rpx; font-weight: 650; color: #FFFFFF;
  background: linear-gradient(135deg, #FFB971, #F2751E);
  border-radius: 999rpx; padding: 12rpx 22rpx;
  box-shadow: 0 8rpx 18rpx -12rpx rgba(232, 138, 58, 0.9);
}
.cand-btn.off { opacity: 0.55; }
.cand-empty {
  background: #F7F9FD; border-radius: 18rpx;
  padding: 22rpx; text-align: center;
}

/* —— 资产出图 —— */
.asset-more { font-size: 22rpx; color: #C4691A; }
.asset-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
}
.asset-cell { min-width: 0; }
.asset-img-wrap {
  position: relative; width: 100%; padding-top: 118%;
  border-radius: 18rpx; overflow: hidden; background: #EEF3FB;
}
.asset-img-wrap.wide { padding-top: 78%; }
.asset-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.asset-ph {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #9AA5B5; text-align: center; padding: 0 12rpx;
  line-height: 1.4; overflow: hidden;
}
.asset-gen {
  position: absolute; right: 8rpx; bottom: 8rpx;
  font-size: 19rpx; color: #FFFFFF;
  background: rgba(22, 35, 58, 0.62);
  border-radius: 999rpx; padding: 7rpx 14rpx;
  backdrop-filter: blur(4rpx);
}
.asset-gen.off { opacity: 0.5; }
.asset-name { font-size: 23rpx; color: #16233A; font-weight: 600; margin-top: 10rpx; }
.asset-sub { font-size: 19rpx; color: #9AA5B5; margin-top: 2rpx; }

.lib-link { color: #C4691A; }

/* —— 改一改弹层（V4.11）：内容多时内部滚动，按钮始终在手边 —— */
.edit-scroll { max-height: 52vh; padding-right: 4rpx; }

/* —— 一致性底座（V4.11）：五维状态一眼可见 —— */
.dim-chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.dim-chip {
  font-size: 20rpx; border-radius: 10rpx; padding: 7rpx 14rpx; line-height: 1.4;
}
.dim-chip.ok { background: #EAF8F2; color: #1E8F6A; }
.dim-chip.bad { background: #FDECEA; color: #C0392B; }

/* —— 资产改设定入口（V4.11）：小而不抢镜 —— */
.asset-edit {
  font-size: 19rpx; color: #C4691A; margin-left: 8rpx;
  text-decoration: underline; text-underline-offset: 3rpx;
}

/* —— 出片规格条（V4.12）：用户点选的画幅/画质/集数/片型有没有真正生效 —— */
.spec-lock { border-radius: 12rpx; padding: 14rpx 16rpx; }
.spec-lock.ok { background: #F3F8F6; }
.spec-lock.bad { background: #FDF3F1; }
.spec-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.spec-k { font-size: 20rpx; color: #8A8F99; }
.spec-v { font-size: 22rpx; color: #2B2F36; flex: 1; }
.spec-tag { font-size: 19rpx; border-radius: 8rpx; padding: 4rpx 10rpx; }
.spec-lock.ok .spec-tag { background: #EAF8F2; color: #1E8F6A; }
.spec-lock.bad .spec-tag { background: #FDECEA; color: #C0392B; }
.spec-issue { color: #C0392B; line-height: 1.5; }

/* —— 角色名册（V4.13）：配角也要有定妆图，缺图在这里一眼看见 —— */
.roster-line {
  display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx;
  margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background: #F7F8FA;
}
.roster-k { font-size: 19rpx; color: #8A8F99; }
.roster-v { font-size: 21rpx; color: #2B2F36; flex: 1; min-width: 260rpx; }
.roster-fill {
  font-size: 20rpx; color: #FFFFFF; background: #C4691A;
  border-radius: 999rpx; padding: 6rpx 18rpx;
}
.roster-fill.off { opacity: .55; }
.roster-ok { font-size: 20rpx; color: #1E8F6A; }
.asset-badge {
  font-size: 17rpx; color: #7A5C1E; background: #FBF3DF;
  border-radius: 6rpx; padding: 2rpx 8rpx; margin-left: 6rpx;
}

/* —— 成片装配（V4.13）：漏镜/重号/废弃版本 —— */
.asm-card.bad { background: #FDF3F1; }
.asm-issue { color: #C0392B; line-height: 1.5; }
