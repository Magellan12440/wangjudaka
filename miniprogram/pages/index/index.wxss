/* 首页：极光 hero + 剧组卡片 */

.stat-strip {
  display: flex;
  align-items: center;
  margin: 30rpx 0 0;
  padding: 22rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(22, 35, 58, 0.06);
  box-shadow: 0 10rpx 26rpx -20rpx rgba(24, 50, 102, 0.4);
}

.hero-create { border-radius: 34rpx; }
.step-badge {
  width: 46rpx; height: 46rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; font-weight: 800; letter-spacing: 0.5rpx;
  color: #6B3A0C;
  background: linear-gradient(140deg, #FFC978, #FF9A45);
  box-shadow: 0 8rpx 18rpx rgba(251, 122, 52, 0.24);
}
.prompt-wrap { position: relative; }
.prompt-area { height: 210rpx; padding-bottom: 44rpx; }
.create-note { text-align: center; font-size: 20rpx; color: #9AA5B5; margin-top: 18rpx; letter-spacing: 0.5rpx; }

.idea-scroll { width: 100%; white-space: nowrap; }
.idea-chip {
  display: inline-flex; align-items: center;
  max-width: 460rpx;
  padding: 13rpx 22rpx; margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(22, 35, 58, 0.04);
  border: 1rpx solid rgba(22, 35, 58, 0.08);
  font-size: 22rpx; color: #6E7B8E;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.idea-spark { color: #E08A22; font-size: 20rpx; margin-right: 10rpx; }

/* 横向剧组卡 */
.proj-scroll { width: 100%; white-space: nowrap; padding: 4rpx 0 8rpx; }
.proj-card {
  display: inline-block; width: 300rpx; margin-right: 20rpx;
  padding: 16rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(22, 35, 58, 0.07);
  box-shadow: 0 12rpx 30rpx -20rpx rgba(24, 50, 102, 0.34);
  box-sizing: border-box;
  vertical-align: top;
}
.proj-cover { height: 300rpx; width: 100%; border-radius: 22rpx; }
.proj-badge {
  position: absolute; top: 12rpx; left: 12rpx; z-index: 2;
  padding: 3rpx 12rpx; border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9); color: #B4551A; font-size: 18rpx;
  border: 1rpx solid rgba(232, 145, 47, 0.4);
}
.proj-title { font-size: 27rpx; font-weight: 650; color: #16233A; margin-top: 16rpx; }
.proj-meta { font-size: 21rpx; color: #8B95A5; margin-top: 6rpx; }
.proj-foot { display: flex; align-items: center; margin-top: 14rpx; }
.mini-progress { flex: 1; height: 6rpx; border-radius: 999rpx; background: rgba(22, 35, 58, 0.08); overflow: hidden; }
.mini-progress-bar { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #FFC57E, #FB7A34); transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
.proj-percent { font-size: 21rpx; color: #E08A22; margin-left: 12rpx; }

/* 列表行 */
.proj-row { display: flex; align-items: center; padding: 22rpx; }
.proj-row-cover { width: 128rpx; height: 168rpx; border-radius: 20rpx; flex-shrink: 0; }
.proj-row-char { font-size: 56rpx; font-weight: 800; color: rgba(255, 255, 255, 0.92); }
.proj-row-title { font-size: 29rpx; font-weight: 650; color: #16233A; flex: 1; margin-right: 12rpx; }

/* 四步流程 */
.flow-strip {
  display: flex; align-items: flex-start;
  padding: 26rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(22, 35, 58, 0.03);
  border: 1rpx solid rgba(22, 35, 58, 0.06);
}
.flow-item { flex: 1; min-width: 0; text-align: center; }
.flow-no {
  width: 44rpx; height: 44rpx; border-radius: 50%; margin: 0 auto 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 18rpx; font-weight: 700; color: #E08A22;
  border: 1rpx solid rgba(232, 145, 47, 0.4);
  background: rgba(232, 145, 47, 0.08);
}
.flow-title { font-size: 23rpx; color: #2A3446; font-weight: 600; }
.flow-sub { font-size: 18rpx; color: #9AA5B5; margin-top: 4rpx; line-height: 1.4; }
.flow-line { flex: 1; height: 1rpx; background: linear-gradient(90deg, rgba(232, 145, 47, 0.4), rgba(22, 35, 58, 0.08)); margin-top: 22rpx; }

/* 快捷入口 */
.quick-row { display: flex; }
.quick {
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx 16rpx;
  border-radius: 24rpx;
  text-align: center;
  background: rgba(22, 35, 58, 0.035);
  border: 1rpx solid rgba(22, 35, 58, 0.07);
}
.quick:last-child { margin-right: 0; }
.quick-icon {
  width: 62rpx; height: 62rpx; margin: 0 auto 12rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #E08A22;
  background: rgba(232, 145, 47, 0.1);
  border: 1rpx solid rgba(232, 145, 47, 0.22);
}
.quick-text { font-size: 22rpx; color: #4A566B; }

.dot-sep { color: #C3CCDA; margin: 0 8rpx; }
.privacy-links { margin-top: 20rpx; font-size: 23rpx; }
.privacy-later { text-align: center; font-size: 23rpx; color: #9AA5B5; margin-top: 24rpx; }

/* —— 索引编号（同名剧靠它区分） —— */
.idx-tag {
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  color: #B4551A;
  background: rgba(232, 145, 47, 0.14);
  font-family: "SF Mono", Menlo, monospace;
}
