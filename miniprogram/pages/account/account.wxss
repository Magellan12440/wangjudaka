/* 账号与额度 · 页面级样式（通用卡片/弹层/单元格在 app.wxss） */
.acc { padding: 28rpx 28rpx 0; }

/* —— 身份 —— */
.who {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(22, 35, 58, 0.06);
  margin-bottom: 22rpx;
}
.who-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFB877 0%, #FF8A3D 100%);
  box-shadow: 0 8rpx 18rpx rgba(255, 138, 61, 0.28);
}
.who-img { width: 100%; height: 100%; }
.who-char { font-size: 38rpx; font-weight: 700; color: #FFFFFF; line-height: 1; }
.who-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #16233A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.who-id { font-size: 21rpx; color: #93A0B2; margin-top: 6rpx; letter-spacing: 0.5rpx; }
.who-badge {
  flex: none;
  font-size: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #F1F5FB;
  color: #7D8A9D;
  line-height: 1.2;
}
.who-badge.on { background: #FFF3E6; color: #C4691A; }

/* —— 额度卡 —— */
.quota-card {
  background: linear-gradient(160deg, #FFFFFF 0%, #FFFAF3 100%);
  border-radius: 30rpx;
  padding: 28rpx 26rpx 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(22, 35, 58, 0.07);
  border: 1rpx solid rgba(255, 176, 110, 0.28);
  margin-bottom: 26rpx;
}
.quota-k { font-size: 23rpx; color: #8B95A5; }
.quota-link { font-size: 22rpx; color: #E08A22; }
.quota-num { display: flex; align-items: baseline; margin: 10rpx 0 20rpx; }
.quota-num .num { font-size: 66rpx; font-weight: 800; color: #16233A; line-height: 1.1; letter-spacing: -1rpx; }
.quota-unit { font-size: 24rpx; color: #8B95A5; margin-left: 10rpx; }
.quota-cny { font-size: 23rpx; color: #B0895F; margin-left: 16rpx; }

.quota-usage {
  display: flex;
  background: rgba(255, 255, 255, 0.78);
  border-radius: 22rpx;
  padding: 18rpx 0;
  border: 1rpx solid rgba(22, 35, 58, 0.05);
}
.qu { flex: 1; text-align: center; min-width: 0; }
.qu + .qu { border-left: 1rpx solid rgba(22, 35, 58, 0.06); }
.qu-v { font-size: 30rpx; font-weight: 700; color: #22314A; line-height: 1.3; }
.qu-l { font-size: 19rpx; color: #93A0B2; margin-top: 4rpx; }

.quota-forecast {
  font-size: 21rpx;
  color: #8A7358;
  line-height: 1.6;
  margin-top: 18rpx;
  padding: 0 4rpx;
}

.quota-alert {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(255, 176, 110, 0.4);
}
.qa-title { font-size: 25rpx; color: #22314A; font-weight: 550; line-height: 1.4; }
.qa-sub { font-size: 20rpx; color: #93A0B2; margin-top: 4rpx; line-height: 1.4; }
.qa-value {
  font-size: 23rpx;
  color: #C4691A;
  background: #FFF3E6;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.qa-arrow { margin-left: 6rpx; color: #D9A268; font-size: 24rpx; }

/* —— 单元格补充 —— */
.cell-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: #F4F7FD;
  color: #5B6A80;
}
.cell-icon.warn { background: #FFF6E8; color: #C4691A; }
.cell-icon.danger { background: #FFF1F1; color: #D8453C; font-weight: 700; }
.tap:active, .tap.tap-on { background: #F7FAFF; }

/* —— 设备列表 —— */
.dev {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.06);
}
.dev:last-of-type { border-bottom: 0; }
.dev-main { flex: 1; min-width: 0; }
.dev-name {
  font-size: 26rpx;
  color: #22314A;
  font-weight: 550;
  line-height: 1.4;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.dev-tag {
  font-size: 18rpx;
  color: #1E8E63;
  background: #EAF8F1;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  line-height: 1.3;
}
.dev-sub { font-size: 20rpx; color: #93A0B2; margin-top: 6rpx; line-height: 1.45; }
.dev-out {
  flex: none;
  font-size: 22rpx;
  color: #D8453C;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #FFF1F1;
}

/* —— 注销风险块 —— */
.danger-box {
  background: #FFF7F7;
  border: 1rpx solid rgba(216, 69, 60, 0.18);
  border-radius: 22rpx;
  padding: 22rpx 22rpx 20rpx;
  margin-bottom: 22rpx;
}
.danger-t { font-size: 25rpx; color: #B93A32; font-weight: 600; margin-bottom: 12rpx; line-height: 1.4; }
.danger-l { font-size: 22rpx; color: #8A6060; line-height: 1.75; }

/* —— 弹层内提示 —— */
.sheet-tip {
  font-size: 23rpx;
  color: #6E7B8E;
  line-height: 1.65;
  margin-bottom: 22rpx;
}
.sheet-note {
  font-size: 21rpx;
  color: #8B95A5;
  line-height: 1.6;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: #F6F9FE;
  border-radius: 16rpx;
}
.sheet-note.on { color: #C4691A; background: #FFF6E8; }
.sheet-err {
  font-size: 22rpx;
  color: #D8453C;
  line-height: 1.6;
  margin-top: 16rpx;
}

.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }

/* —— 切换账号 —— */
.acc-row {
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(22, 35, 58, 0.06);
}
.acc-row:last-of-type { border-bottom: none; }
.acc-row.on { background: transparent; }
.acc-avatar {
  width: 64rpx; height: 64rpx; border-radius: 20rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: #4A566B;
  background: #EEF3FB; overflow: hidden;
}
.acc-avatar.on {
  color: #FFFFFF;
  background: linear-gradient(140deg, #FFB971, #F2751E);
  box-shadow: 0 8rpx 18rpx -10rpx rgba(232, 138, 58, 0.9);
}
.acc-img { width: 100%; height: 100%; }
.acc-name { font-size: 28rpx; font-weight: 650; color: #16233A; line-height: 1.4; }
.acc-tag {
  font-size: 18rpx; color: #B4551A; background: #FFF1DF;
  border-radius: 8rpx; padding: 2rpx 8rpx; margin-left: 8rpx;
}
.acc-now {
  font-size: 20rpx; color: #22B07D; background: #E9F9F1;
  border-radius: 999rpx; padding: 5rpx 14rpx; flex: none;
}
.acc-relogin {
  font-size: 20rpx; color: #C4691A; background: #FFF4E4;
  border-radius: 999rpx; padding: 5rpx 14rpx; flex: none;
}
.cell-icon.plus { font-size: 30rpx; color: #4A566B; background: #EEF3FB; }
.cell-foot {
  font-size: 20rpx; color: #9AA5B5; text-align: center;
  padding: 14rpx 0 4rpx;
}
